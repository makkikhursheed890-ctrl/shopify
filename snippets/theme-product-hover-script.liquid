<script>
  (() => {
    if (window.themeProductHoverInitialized) return;
    window.themeProductHoverInitialized = true;

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    })[character]);

    const ensureQuickViewModal = () => {
      if (document.querySelector('[data-theme-quick-view]')) return;
      const modal = document.createElement('div');
      modal.className = 'theme-quick-view';
      modal.dataset.themeQuickView = '';
      modal.setAttribute('role', 'dialog');
      modal.setAttribute('aria-modal', 'true');
      modal.setAttribute('aria-hidden', 'true');
      modal.innerHTML = `
        <div class="theme-quick-view__backdrop" data-theme-quick-close></div>
        <div class="theme-quick-view__dialog">
          <button class="theme-quick-view__close" type="button" data-theme-quick-close aria-label="Close quick view">&times;</button>
          <div class="theme-quick-view__content" data-theme-quick-content>
            <p>Loading product...</p>
          </div>
        </div>
      `;
      document.body.appendChild(modal);
      modal.querySelectorAll('[data-theme-quick-close]').forEach((button) => {
        button.addEventListener('click', closeQuickView);
      });
    };

    const closeQuickView = () => {
      const modal = document.querySelector('[data-theme-quick-view]');
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    const openQuickView = async (handle) => {
      ensureQuickViewModal();
      const modal = document.querySelector('[data-theme-quick-view]');
      const content = modal.querySelector('[data-theme-quick-content]');
      content.innerHTML = '<p>Loading product...</p>';
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      try {
        const product = await fetch(`/products/${encodeURIComponent(handle)}.js`, { headers: { Accept: 'application/json' } }).then((result) => result.json());
        const images = product.images?.length ? product.images : (product.featured_image ? [product.featured_image] : []);
        const variants = product.variants || [];
        const options = (product.options || []).filter((option) => option.name && option.values?.length > 1);

        const optionMarkup = options.map((option, index) => `
          <label class="theme-quick-view__option">
            <span>${escapeHtml(option.name)}</span>
            <select data-quick-option-index="${index}">
              ${option.values.map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`).join('')}
            </select>
          </label>
        `).join('');

        content.innerHTML = `
          <div class="theme-quick-view__gallery">
            ${images.slice(0, 4).map((image, index) => `<img src="${escapeHtml(image)}" alt="${escapeHtml(product.title)} ${index + 1}" loading="lazy">`).join('')}
          </div>
          <div class="theme-quick-view__details">
            <p class="theme-quick-view__vendor">${escapeHtml(product.vendor || '')}</p>
            <h2>${escapeHtml(product.title)}</h2>
            <div class="theme-quick-view__price">${window.Shopify?.formatMoney ? Shopify.formatMoney(product.price, window.themeMoneyFormat || '') : `$${(product.price / 100).toFixed(2)}`}</div>
            ${optionMarkup}
            <p class="theme-quick-view__description">${product.description || ''}</p>
            <button class="theme-quick-view__add" type="button" data-quick-add="${variants[0]?.id || ''}" ${product.available ? '' : 'disabled'}>
              ${product.available ? 'Add to cart' : 'Sold out'}
            </button>
            <a class="theme-quick-view__link" href="${escapeHtml(product.url)}">View full details</a>
          </div>
        `;

        const updateVariant = () => {
          const selections = [...content.querySelectorAll('[data-quick-option-index]')].map((select) => select.value);
          const variant = variants.find((item) => selections.every((value, index) => item.options[index] === value)) || variants.find((item) => item.available) || variants[0];
          const addButton = content.querySelector('[data-quick-add]');
          if (!variant || !addButton) return;
          addButton.dataset.quickAdd = variant.id;
          addButton.disabled = !variant.available;
          addButton.textContent = variant.available ? 'Add to cart' : 'Sold out';
        };
        content.querySelectorAll('[data-quick-option-index]').forEach((select) => select.addEventListener('change', updateVariant));
        updateVariant();
      } catch (error) {
        content.innerHTML = '<p>Unable to load this product.</p>';
      }
    };

    const quickViewStyles = document.createElement('style');
    quickViewStyles.textContent = `
      .theme-quick-view { position: fixed; inset: 0; z-index: 10000; visibility: hidden; opacity: 0; transition: opacity .25s ease, visibility .25s ease; }
      .theme-quick-view.is-open { visibility: visible; opacity: 1; }
      .theme-quick-view__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.55); }
      .theme-quick-view__dialog { position: absolute; left: 50%; top: 50%; width: min(920px, calc(100% - 40px)); max-height: calc(100vh - 40px); overflow: auto; transform: translate(-50%, -48%); background: #fff; color: #111; box-shadow: 0 20px 60px rgba(0,0,0,.25); transition: transform .25s ease; }
      .theme-quick-view.is-open .theme-quick-view__dialog { transform: translate(-50%, -50%); }
      .theme-quick-view__close { position: absolute; right: 12px; top: 12px; z-index: 2; width: 40px; height: 40px; border: 0; border-radius: 50%; background: #fff; font-size: 28px; line-height: 1; cursor: pointer; box-shadow: 0 3px 12px rgba(0,0,0,.12); }
      .theme-quick-view__content { display: grid; grid-template-columns: 58% 42%; }
      .theme-quick-view__gallery { min-height: 520px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; background: #f4f4f4; }
      .theme-quick-view__gallery img { width: 100%; height: 260px; object-fit: cover; }
      .theme-quick-view__details { padding: 54px 38px 38px; }
      .theme-quick-view__details h2 { margin: 4px 0 12px; font-size: 30px; }
      .theme-quick-view__vendor { margin: 0; text-transform: uppercase; letter-spacing: .12em; font-size: 11px; color: #777; }
      .theme-quick-view__price { margin-bottom: 20px; font-size: 20px; font-weight: 700; }
      .theme-quick-view__option { display: grid; gap: 7px; margin-bottom: 14px; font-weight: 700; }
      .theme-quick-view__option select { height: 44px; border: 1px solid #ddd; border-radius: 0; padding: 0 12px; background: #fff; }
      .theme-quick-view__description { max-height: 130px; overflow: auto; line-height: 1.55; color: #555; }
      .theme-quick-view__add { width: 100%; height: 48px; margin-top: 8px; border: 0; background: #111; color: #fff; font-weight: 700; cursor: pointer; }
      .theme-quick-view__add:disabled { opacity: .55; cursor: not-allowed; }
      .theme-quick-view__link { display: block; margin-top: 14px; text-align: center; color: #111; }
      @media(max-width:749px) { .theme-quick-view__dialog { width: calc(100% - 20px); max-height: calc(100vh - 20px); } .theme-quick-view__content { grid-template-columns: 1fr; } .theme-quick-view__gallery { min-height: 260px; } .theme-quick-view__gallery img { height: 260px; } .theme-quick-view__details { padding: 28px 20px 24px; } .theme-quick-view__details h2 { font-size: 24px; } }
    `;
    document.head.appendChild(quickViewStyles);

    document.addEventListener('click', async (event) => {
      const quickViewButton = event.target.closest('[data-product-quick-view]');
      if (quickViewButton) {
        event.preventDefault();
        event.stopPropagation();
        openQuickView(quickViewButton.dataset.productQuickView);
        return;
      }

      const quickAddButton = event.target.closest('[data-quick-add]');
      if (quickAddButton) {
        event.preventDefault();
        const variantId = Number(quickAddButton.dataset.quickAdd);
        if (!variantId) return;
        quickAddButton.disabled = true;
        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ id: variantId, quantity: 1 })
          });
          if (!response.ok) throw new Error('Could not add product');
          await window.themeRefreshHeaderCart?.();
          closeQuickView();
          window.setTimeout(() => window.themeOpenHeaderCart?.(), 100);
        } catch (error) {
          quickAddButton.disabled = false;
        }
        return;
      }

      const button = event.target.closest('[data-product-hover-add]');
      if (!button) return;

      event.preventDefault();
      event.stopPropagation();

      const variantId = Number(button.dataset.productHoverAdd);
      if (!variantId) return;

      const originalOpacity = button.style.opacity;
      button.disabled = true;
      button.classList.remove('is-added');

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        });
        if (!response.ok) throw new Error('Could not add product');

        const cart = await fetch('/cart.js', { headers: { Accept: 'application/json' } }).then((result) => result.json());
        document.querySelectorAll('.site-header__cart-count').forEach((count) => {
          count.textContent = cart.item_count;
        });

        button.classList.add('is-added');

        const imageUrl = button.dataset.productImage;
        const cartIcon = document.querySelector('.site-header__actions [data-header-drawer="cart"]');
        if (imageUrl && cartIcon) {
          const buttonRect = button.getBoundingClientRect();
          const cartRect = cartIcon.getBoundingClientRect();
          const flyImage = document.createElement('img');
          flyImage.className = 'theme-product-fly-image';
          flyImage.src = imageUrl;
          flyImage.style.left = `${buttonRect.left}px`;
          flyImage.style.top = `${buttonRect.top}px`;
          flyImage.style.width = '46px';
          flyImage.style.height = '46px';
          document.body.appendChild(flyImage);
          requestAnimationFrame(() => {
            flyImage.style.transform = `translate(${cartRect.left - buttonRect.left}px, ${cartRect.top - buttonRect.top}px) scale(0.15)`;
            flyImage.style.opacity = '0';
          });
          window.setTimeout(() => flyImage.remove(), 700);
        }

        await window.themeRefreshHeaderCart?.();
        window.setTimeout(() => window.themeOpenHeaderCart?.(), 260);

        window.setTimeout(() => {
          button.classList.remove('is-added');
          button.disabled = false;
          button.style.opacity = originalOpacity;
        }, 1400);
      } catch (error) {
        button.disabled = false;
        button.style.opacity = originalOpacity;
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeQuickView();
    });
  })();
</script>
