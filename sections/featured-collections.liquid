<style>
  .featured-collections { max-width: {{ section.settings.page_width }}px; margin: 0 auto; padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px; }
  .featured-collections__heading { margin: 0 0 28px; font-size: clamp(28px, 4vw, 42px); text-align: {{ section.settings.heading_alignment }}; }
  .featured-collections__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0,1fr)); gap: 16px; }
  .featured-collections__block-mobile-hidden { display: none; }
  @media (min-width: 750px) {
    .featured-collections__block-mobile-hidden { display: block; }
    .featured-collections__block-desktop-hidden { display: none !important; }
  }
  @media (max-width: 749px) {
    .featured-collections__block-desktop-hidden { display: none !important; }
    .featured-collections__block-mobile-hidden { display: block; }
  }
  .featured-collection { position: relative; aspect-ratio: 1/1.05; overflow: hidden; background: #f5f5f5; }
  .featured-collection img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .featured-collection:hover img { transform: scale(1.035); }
  .featured-collection__label { position: absolute; right: 12px; bottom: 12px; left: 12px; min-height: 48px; display: grid; place-items: center; background: rgba(255,255,255,.95); color: #111; font-weight: 700; }
  @media (max-width: 989px) { .featured-collections__grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 749px) { .featured-collections { padding-inline: 16px; } .featured-collections__grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; } }
</style>

<section class="featured-collections" {{ section.shopify_attributes }}>
  {% if section.settings.heading != blank %}<h2 class="featured-collections__heading">{{ section.settings.heading }}</h2>{% endif %}
  <div class="featured-collections__grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        {% assign classes = '' %}
        {% unless block.settings.show_on_desktop %}{% assign classes = classes | append: ' featured-collections__block-desktop-hidden' %}{% endunless %}
        {% unless block.settings.show_on_mobile %}{% assign classes = classes | append: ' featured-collections__block-mobile-hidden' %}{% endunless %}
        {% if collection != blank %}
          {% assign card_link = block.settings.link_override | default: collection.url %}
          <a class="featured-collection{{ classes }}" href="{{ card_link }}" {{ block.shopify_attributes }}>
            {% assign card_image = block.settings.image | default: collection.featured_image %}
            {% if card_image %}<img src="{{ card_image | image_url: width: 700 }}" alt="{{ block.settings.image_alt | default: collection.title | escape }}" width="700" height="735" loading="lazy">{% endif %}
            <span class="featured-collection__label" style="background: {{ block.settings.label_background }}; color: {{ block.settings.label_color }};">{{ block.settings.label | default: collection.title }}</span>
          </a>
        {% endif %}
      {% endfor %}
    {% else %}
      {% if section.settings.collection_1 != blank %}<a class="featured-collection" href="{{ section.settings.collection_1.url }}">{% if section.settings.collection_1.featured_image %}<img src="{{ section.settings.collection_1.featured_image | image_url: width: 700 }}" alt="{{ section.settings.collection_1.title | escape }}" width="700" height="735" loading="lazy">{% endif %}<span class="featured-collection__label">{{ section.settings.collection_1.title }}</span></a>{% endif %}
      {% if section.settings.collection_2 != blank %}<a class="featured-collection" href="{{ section.settings.collection_2.url }}">{% if section.settings.collection_2.featured_image %}<img src="{{ section.settings.collection_2.featured_image | image_url: width: 700 }}" alt="{{ section.settings.collection_2.title | escape }}" width="700" height="735" loading="lazy">{% endif %}<span class="featured-collection__label">{{ section.settings.collection_2.title }}</span></a>{% endif %}
      {% if section.settings.collection_3 != blank %}<a class="featured-collection" href="{{ section.settings.collection_3.url }}">{% if section.settings.collection_3.featured_image %}<img src="{{ section.settings.collection_3.featured_image | image_url: width: 700 }}" alt="{{ section.settings.collection_3.title | escape }}" width="700" height="735" loading="lazy">{% endif %}<span class="featured-collection__label">{{ section.settings.collection_3.title }}</span></a>{% endif %}
      {% if section.settings.collection_4 != blank %}<a class="featured-collection" href="{{ section.settings.collection_4.url }}">{% if section.settings.collection_4.featured_image %}<img src="{{ section.settings.collection_4.featured_image | image_url: width: 700 }}" alt="{{ section.settings.collection_4.title | escape }}" width="700" height="735" loading="lazy">{% endif %}<span class="featured-collection__label">{{ section.settings.collection_4.title }}</span></a>{% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "tag": "section",
  "class": "section-featured-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by collection" },
    { "type": "collection", "id": "collection_1", "label": "Collection 1" },
    { "type": "collection", "id": "collection_2", "label": "Collection 2" },
    { "type": "collection", "id": "collection_3", "label": "Collection 3" },
    { "type": "collection", "id": "collection_4", "label": "Collection 4" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "range", "id": "page_width", "min": 960, "max": 1800, "step": 20, "unit": "px", "label": "Page width", "default": 1400 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
    ] }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "label", "label": "Label", "info": "Leave blank to use the collection title" },
        { "type": "url", "id": "link_override", "label": "Link override" },
        { "type": "color", "id": "label_background", "label": "Label background", "default": "#ffffff" },
        { "type": "color", "id": "label_color", "label": "Label text", "default": "#111111" },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Featured collections", "blocks": [{ "type": "collection_card" }, { "type": "collection_card" }, { "type": "collection_card" }, { "type": "collection_card" }] }]
}
{% endschema %}
