<style>
  .collection-banner {
    min-height: {{ section.settings.banner_height }}px;
    position: relative;
    display: grid;
    {% if section.settings.text_position == 'left' %}
      place-items: center start;
    {% elsif section.settings.text_position == 'right' %}
      place-items: center end;
    {% else %}
      place-items: center;
    {% endif %}
    overflow: hidden;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .collection-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
  }

  .collection-banner__content {
    position: relative;
    z-index: 1;
    max-width: {{ section.settings.content_width }}px;
    padding: 40px 20px;
    text-align: {{ section.settings.text_alignment }};
  }

  .collection-banner__title {
    margin: 0;
    font-size: clamp(38px, 6vw, 72px);
    line-height: 1;
  }

  .collection-banner__text {
    margin: 18px 0 0;
    line-height: 1.7;
  }
  .collection-banner__button {
    min-height: 52px;
    padding: 0 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 749px) {
    .collection-banner {
      min-height: 280px;
    }

    .collection-banner__title {
      font-size: 38px;
    }
  }
</style>

<section class="collection-banner" {{ section.shopify_attributes }}>
  {% if collection.image %}
    <img
      class="collection-banner__image"
      src="{{ collection.image | image_url: width: 1800 }}"
      alt="{{ collection.image.alt | default: collection.title | escape }}"
      width="1800"
      height="800"
      loading="lazy"
    >
  {% elsif section.settings.image %}
    <img
      class="collection-banner__image"
      src="{{ section.settings.image | image_url: width: 1800 }}"
      alt="{{ section.settings.image.alt | escape }}"
      width="1800"
      height="800"
      loading="lazy"
    >
  {% endif %}
  {% if collection.image or section.settings.image %}
    <div class="collection-banner__overlay"></div>
  {% endif %}

  <div class="collection-banner__content">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            <h1 class="collection-banner__title" style="font-size: {{ block.settings.font_size }}px; color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
              {{ block.settings.heading | default: collection.title }}
            </h1>
          {% when 'text' %}
            {% if block.settings.text != blank or collection.description != blank %}
              <div class="collection-banner__text" style="font-size: {{ block.settings.font_size }}px; color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
                {{ block.settings.text | default: collection.description }}
              </div>
            {% endif %}
          {% when 'button' %}
            {% if block.settings.label != blank and block.settings.link != blank %}
              <a class="collection-banner__button" style="margin-top: {{ block.settings.margin_top }}px; background: {{ block.settings.background }}; color: {{ block.settings.color }};" href="{{ block.settings.link }}" {{ block.shopify_attributes }} {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ block.settings.label }}</a>
            {% endif %}
        {% endcase %}
      {% endfor %}
    {% else %}
      <h1 class="collection-banner__title">{{ section.settings.heading | default: collection.title }}</h1>
      {% if section.settings.show_collection_description and collection.description != blank %}
        <div class="collection-banner__text">{{ collection.description }}</div>
      {% elsif section.settings.text != blank %}
        <div class="collection-banner__text">{{ section.settings.text }}</div>
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the collection title" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_collection_description", "label": "Show collection description", "default": true },
    { "type": "image_picker", "id": "image", "label": "Fallback image" },
    { "type": "range", "id": "banner_height", "min": 280, "max": 700, "step": 20, "unit": "px", "label": "Banner height", "default": 420 },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Image overlay opacity", "default": 30 },
    { "type": "range", "id": "content_width", "min": 400, "max": 1000, "step": 20, "unit": "px", "label": "Content width", "default": 700 },
    { "type": "select", "id": "text_position", "label": "Content position", "default": "center", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the collection title" },
        { "type": "range", "id": "font_size", "min": 28, "max": 72, "step": 2, "unit": "px", "label": "Font size", "default": 72 },
        { "type": "color", "id": "color", "label": "Text color", "default": "#ffffff" },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    },
    {
      "type": "text",
      "name": "Description",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "info": "Leave blank to use the collection description" },
        { "type": "range", "id": "font_size", "min": 12, "max": 30, "step": 1, "unit": "px", "label": "Font size", "default": 18 },
        { "type": "color", "id": "color", "label": "Text color", "default": "#ffffff" },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "Open in new tab", "default": false },
        { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
        { "type": "color", "id": "color", "label": "Text color", "default": "#111111" },
        { "type": "range", "id": "margin_top", "min": 0, "max": 40, "step": 4, "unit": "px", "label": "Spacing above", "default": 8 },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Collection banner", "blocks": [{ "type": "heading" }, { "type": "text" }] }
  ]
}
{% endschema %}
