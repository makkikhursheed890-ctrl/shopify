<style>
  .site-header {
    position: relative;
    z-index: 20;
    width: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  .site-header--sticky {
    position: sticky;
    top: 0;
  }

  .site-header__inner {
    min-height: {{ section.settings.header_height }}px;
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: 10px 20px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    box-sizing: border-box;
  }

  .site-header__logo {
    justify-self: start;
    color: inherit;
    text-decoration: none;
  }

  .site-header__logo-image {
    display: block;
    width: {{ section.settings.logo_width }}px;
    max-width: 100%;
    height: auto;
  }

  .site-header__logo-text {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 0.5px;
  }

  .site-header__menu {
    justify-self: center;
  }

  .site-header__menu-list {
    display: flex;
    align-items: center;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__menu-link,
  .site-header__dropdown summary {
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .site-header__dropdown {
    position: relative;
  }

  .site-header__dropdown summary::-webkit-details-marker {
    display: none;
  }

  .site-header__dropdown-menu {
    position: absolute;
    top: calc(100% + 16px);
    left: -16px;
    min-width: 220px;
    padding: 12px;
    background: {{ section.settings.background_color }};
    border: 1px solid {{ section.settings.border_color }};
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
  }

  .site-header__dropdown-menu--products {
    width: min(620px, calc(100vw - 40px));
    left: 50%;
    transform: translateX(-50%);
  }

  .header-desktop-menu-products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid {{ section.settings.border_color }};
  }

  .header-desktop-menu-product {
    min-width: 0;
    color: inherit !important;
    padding: 0 !important;
    text-decoration: none;
    border-radius: 6px;
    overflow: hidden;
    transition: transform 0.2s ease;
  }

  .header-desktop-menu-product img {
    width: 100%;
    aspect-ratio: 1;
    display: block;
    object-fit: cover;
    background: #f4f4f4;
    transition: transform 0.25s ease;
  }

  .header-desktop-menu-product__title {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    line-height: 1.3;
    font-weight: 700;
  }

  .header-desktop-menu-product__price {
    margin-top: 3px;
    font-size: 12px;
    font-weight: 700;
  }

  .header-desktop-menu-product:hover img {
    transform: scale(1.04);
  }

  .header-desktop-menu-product:hover {
    transform: translateY(-2px);
  }

  .site-header__dropdown-menu a {
    display: block;
    padding: 9px 8px;
    color: inherit;
    text-decoration: none;
  }

  .site-header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .site-header__icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
  }

  .site-header__icon svg {
    width: 22px;
    height: 22px;
  }

  .site-header__cart-count {
    position: absolute;
    top: -9px;
    right: -10px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    background: {{ section.settings.text_color }};
    color: {{ section.settings.background_color }};
    font-size: 11px;
    font-weight: 700;
  }

  .site-header__mobile-toggle {
    display: none;
  }

  .site-header__mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    box-sizing: border-box;
    background: {{ section.settings.background_color }};
    border-top: 1px solid {{ section.settings.border_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
    padding: 16px 20px 24px;
  }

  .site-header__mobile-menu summary {
    padding: 12px 0;
    font-weight: 700;
    cursor: pointer;
  }

  .site-header__mobile-menu a {
    display: block;
    padding: 12px 0;
    color: inherit;
    text-decoration: none;
    font-weight: 700;
  }

  .site-header__mobile-menu details a {
    padding-left: 14px;
    font-weight: 500;
  }

  .site-header__button {
    appearance: none;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }

  .header-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: hidden;
    opacity: 0;
    background: rgba(0, 0, 0, 0.45);
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .header-overlay.is-open {
    visibility: visible;
    opacity: 1;
  }

  .header-drawer {
    position: fixed;
    z-index: 101;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(420px, calc(100vw - 40px));
    box-sizing: border-box;
    overflow-y: auto;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    transform: translateX(100%);
    transition: transform 0.25s ease;
  }

  .header-drawer.is-open {
    transform: translateX(0);
  }

  .header-drawer--left {
    right: auto;
    left: 0;
    transform: translateX(-100%);
  }

  .header-drawer--left.is-open {
    transform: translateX(0);
  }

  .header-drawer--search {
    right: 0;
    left: 0;
    bottom: auto;
    width: 100%;
    max-height: 70vh;
    transform: translateY(-100%);
  }

  .header-drawer--search.is-open {
    transform: translateY(0);
  }

  .header-drawer__header {
    min-height: 70px;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  .header-drawer__title {
    margin: 0;
    font-size: 20px;
  }

  .header-drawer__close {
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 28px;
    cursor: pointer;
  }

  .header-drawer__body {
    padding: 20px 24px 32px;
  }

  .header-menu-drawer a {
    display: block;
    padding: 13px 0;
    color: inherit;
    text-decoration: none;
    font-weight: 700;
  }

  .header-menu-drawer details {
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  .header-menu-drawer details summary {
    padding: 13px 0;
    cursor: pointer;
    font-weight: 700;
  }

  .header-menu-drawer details a {
    padding-left: 14px;
    font-weight: 500;
  }

  .header-menu-products {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid {{ section.settings.border_color }};
  }

  .header-menu-products__heading {
    margin: 0 0 14px;
    font-size: 16px;
  }

  .header-menu-products__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .header-menu-drawer .header-menu-products__grid {
    gap: 14px;
  }

  .header-menu-drawer a.header-menu-product {
    min-width: 0;
    padding: 0;
    color: inherit;
    text-decoration: none;
    font-weight: 500;
    border-radius: 6px;
    overflow: hidden;
  }

  .header-menu-product img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #f4f4f4;
    border-radius: 6px;
    transition: transform 0.25s ease;
  }

  .header-menu-product__title,
  .header-menu-product__price {
    display: block;
    margin-top: 7px;
    line-height: 1.3;
  }

  .header-menu-product__title {
    font-size: 13px;
  }

  .header-menu-product__price {
    font-size: 13px;
    font-weight: 700;
  }

  .header-search-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
  }

  .header-search-form input {
    width: 100%;
    height: 48px;
    box-sizing: border-box;
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 0;
    padding: 0 14px;
    color: {{ section.settings.text_color }};
    background: {{ section.settings.background_color }};
  }

  .header-search-form button,
  .header-cart__checkout {
    min-height: 48px;
    border: 0;
    padding: 0 18px;
    background: {{ section.settings.text_color }};
    color: {{ section.settings.background_color }};
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .header-search-results {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 20px;
  }

  .header-search-result {
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .header-search-result img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #f4f4f4;
  }

  .header-search-result__title,
  .header-search-result__price {
    display: block;
    margin-top: 8px;
  }

  .header-search-result__price {
    font-weight: 700;
  }

  .header-search-empty {
    margin: 20px 0 0;
  }

  @media (max-width: 749px) {
    .header-search-results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-height: calc(70vh - 180px);
      overflow-y: auto;
    }
  }

  .header-account-link {
    margin-bottom: 10px;
  }

  .header-cart__item {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  .header-cart__item img {
    width: 70px;
    height: 90px;
    object-fit: cover;
  }

  .header-cart__item a {
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  .header-cart__footer {
    margin-top: 20px;
    display: grid;
    gap: 12px;
  }

  .header-cart__item-details {
    min-width: 0;
  }

  .header-cart__line-controls {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .header-cart__quantity {
    height: 34px;
    display: inline-grid;
    grid-template-columns: 34px 38px 34px;
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 4px;
    overflow: hidden;
  }

  .header-cart__quantity button,
  .header-cart__quantity span {
    border: 0;
    background: transparent;
    color: inherit;
    display: grid;
    place-items: center;
    font-size: 14px;
  }

  .header-cart__quantity button {
    cursor: pointer;
  }

  .header-cart__quantity button:hover {
    background: rgba(0, 0, 0, 0.06);
  }

  .header-cart__quantity button:disabled {
    cursor: default;
    opacity: 0.55;
  }

  .header-cart__remove {
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .header-cart__remove:hover {
    background: rgba(0, 0, 0, 0.06);
  }

  .header-cart__remove svg {
    width: 18px;
    height: 18px;
  }

  .header-cart__checkout {
    display: grid;
    place-items: center;
  }

  .header-cart-empty {
    min-height: calc(100vh - 120px);
    box-sizing: border-box;
    padding: 20px 0 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .header-cart-empty__title {
    margin: 0 0 12px;
    font-size: 30px;
    line-height: 1.1;
  }

  .header-cart-empty__text {
    margin: 0 0 22px;
    color: inherit;
    line-height: 1.6;
    opacity: 0.75;
  }

  .header-cart-empty__button {
    width: min(280px, 100%);
    min-height: 52px;
    display: grid;
    place-items: center;
    background: {{ section.settings.text_color }};
    color: {{ section.settings.background_color }};
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 989px) {
    .site-header__inner {
      grid-template-columns: 44px minmax(0, 1fr) 44px;
      gap: 8px;
    }

    .site-header__menu {
      display: none;
    }

    .site-header__logo {
      justify-self: center;
    }

    .site-header__logo-image {
      width: min({{ section.settings.logo_width }}px, 180px);
    }

    .site-header__mobile-toggle {
      justify-self: start;
      display: inline-flex;
      border: 0;
      background: transparent;
      cursor: pointer;
    }

    .site-header__account {
      display: none;
    }
  }

  @media (min-width: 990px) and (max-width: 1199px) {
    .site-header__dropdown-menu--products {
      width: min(520px, calc(100vw - 40px));
    }
    .header-desktop-menu-products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .header-drawer {
      width: calc(100vw - 20px);
    }
    .header-drawer__header {
      min-height: 60px;
      padding-inline: 16px;
    }
    .header-drawer__body {
      padding: 16px 16px 24px;
    }
    .header-menu-drawer .header-menu-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .header-menu-product img {
      height: 150px;
      aspect-ratio: auto;
    }
    .header-menu-product__title {
      font-size: 12px;
    }
  }

  @media (min-width: 421px) and (max-width: 749px) {
    .header-menu-drawer .header-menu-products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
  }
</style>

<header class="site-header{% if section.settings.sticky_header %} site-header--sticky{% endif %}" {{ section.shopify_attributes }}>
  <div class="site-header__inner">
    <button class="site-header__mobile-toggle site-header__icon site-header__button" type="button" data-header-drawer="menu" aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
    </button>

    {% assign header_logo_rendered = false %}
    {% for block in section.blocks %}
      {% if block.type == 'brand_logo' %}
        {% assign header_logo_rendered = true %}
        <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}" {{ block.shopify_attributes }}>
          {% if block.settings.logo != blank %}
            <img class="site-header__logo-image" src="{{ block.settings.logo | image_url: width: 500 }}" alt="{{ block.settings.logo.alt | default: shop.name | escape }}" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}">
          {% else %}
            <span class="site-header__logo-text">{{ block.settings.logo_text | default: shop.name }}</span>
          {% endif %}
        </a>
      {% endif %}
    {% endfor %}
    {% if header_logo_rendered == false %}
      <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {% if section.settings.logo != blank %}
        <img
          class="site-header__logo-image"
          src="{{ section.settings.logo | image_url: width: 500 }}"
          srcset="{{ section.settings.logo | image_url: width: 100 }} 100w,
                  {{ section.settings.logo | image_url: width: 200 }} 200w,
                  {{ section.settings.logo | image_url: width: 300 }} 300w,
                  {{ section.settings.logo | image_url: width: 500 }} 500w"
          sizes="{{ section.settings.logo_width }}px"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
        >
      {% else %}
        <span class="site-header__logo-text">{{ section.settings.logo_text | default: shop.name }}</span>
      {% endif %}
      </a>
    {% endif %}

    <nav class="site-header__menu" aria-label="Main navigation">
      <ul class="site-header__menu-list">
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}
            <li>
              {% if link.links != blank %}
                <details class="site-header__dropdown">
                  <summary>{{ link.title }}</summary>
                  <div class="site-header__dropdown-menu{% if section.settings.show_menu_products and section.settings.mobile_menu_collection != blank %} site-header__dropdown-menu--products{% endif %}">
                    {% for child_link in link.links %}
                      <a href="{{ child_link.url }}" {% if child_link.current %}aria-current="page"{% endif %}>
                        {{ child_link.title }}
                      </a>
                    {% endfor %}
                    {% if section.settings.show_menu_products %}
                      <div class="header-desktop-menu-products">
                        {% if section.settings.mobile_menu_collection != blank %}
                          {% assign menu_product_collection = section.settings.mobile_menu_collection %}
                        {% else %}
                          {% assign menu_product_collection = collections.all %}
                        {% endif %}
                        {% for product in menu_product_collection.products limit: section.settings.mobile_menu_product_limit %}
                          <a class="header-desktop-menu-product" href="{{ product.url }}">
                            {% if product.featured_media %}
                              <img
                                src="{{ product.featured_media.preview_image | image_url: width: 240 }}"
                                alt="{{ product.featured_media.alt | default: product.title | escape }}"
                                width="240"
                                height="240"
                                loading="lazy"
                              >
                            {% endif %}
                            <span class="header-desktop-menu-product__title">{{ product.title }}</span>
                            {% if section.settings.show_mobile_menu_product_price %}
                              <span class="header-desktop-menu-product__title header-desktop-menu-product__price">{{ product.price | money }}</span>
                            {% endif %}
                          </a>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                </details>
              {% else %}
                <a class="site-header__menu-link" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                  {{ link.title }}
                </a>
              {% endif %}
            </li>
          {% endfor %}
        {% endif %}
      </ul>
    </nav>

    <div class="site-header__actions">
      {% if section.settings.show_search %}
        <button class="site-header__icon site-header__button" type="button" data-header-drawer="search" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="M16 16l5 5"></path>
          </svg>
        </button>
      {% endif %}

      {% if shop.customer_accounts_enabled and section.settings.show_account %}
        <button class="site-header__icon site-header__account site-header__button" type="button" data-header-drawer="account" aria-label="Account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="8" r="3.5"></circle>
            <path d="M4.5 21a7.5 7.5 0 0115 0"></path>
          </svg>
        </button>
      {% endif %}

      {% if section.settings.show_cart %}
        <button class="site-header__icon site-header__button" type="button" data-header-drawer="cart" aria-label="Cart with {{ cart.item_count }} items">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M3 4h2l2.4 11h9.9l2-7H6"></path>
            <circle cx="9" cy="20" r="1"></circle>
            <circle cx="17" cy="20" r="1"></circle>
          </svg>
          <span class="site-header__cart-count">{{ cart.item_count }}</span>
        </button>
      {% endif %}
    </div>
  </div>
</header>

<div class="header-overlay" data-header-overlay></div>

<aside class="header-drawer header-drawer--left header-menu-drawer" data-header-panel="menu" aria-label="Menu drawer" aria-hidden="true">
  <div class="header-drawer__header">
    {% assign menu_drawer_heading = 'Menu' %}
    {% for block in section.blocks %}
      {% if block.type == 'drawer_title' and block.settings.drawer == 'menu' and block.settings.title != blank %}
        {% assign menu_drawer_heading = block.settings.title %}
      {% endif %}
    {% endfor %}
    <h2 class="header-drawer__title" {% for block in section.blocks %}{% if block.type == 'drawer_title' and block.settings.drawer == 'menu' %}{{ block.shopify_attributes }}{% endif %}{% endfor %}>{{ menu_drawer_heading }}</h2>
    <button class="header-drawer__close" type="button" data-header-close aria-label="Close menu">&times;</button>
  </div>
  <nav class="header-drawer__body" aria-label="Mobile navigation">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        {% if link.links != blank %}
          <details>
            <summary>{{ link.title }}</summary>
            {% for child_link in link.links %}
              <a href="{{ child_link.url }}">{{ child_link.title }}</a>
            {% endfor %}
          </details>
        {% else %}
          <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if section.settings.show_menu_products %}
      <div class="header-menu-products">
        {% assign mobile_products_heading = section.settings.mobile_menu_products_heading %}
        {% for block in section.blocks %}
          {% if block.type == 'mobile_products_heading' %}
            {% assign mobile_products_heading = block.settings.heading %}
          {% endif %}
        {% endfor %}
        {% if mobile_products_heading != blank %}
          <h3 class="header-menu-products__heading" {% for block in section.blocks %}{% if block.type == 'mobile_products_heading' %}{{ block.shopify_attributes }}{% endif %}{% endfor %}>{{ mobile_products_heading }}</h3>
        {% endif %}
        <div class="header-menu-products__grid">
          {% if section.settings.mobile_menu_collection != blank %}
            {% assign menu_product_collection = section.settings.mobile_menu_collection %}
          {% else %}
            {% assign menu_product_collection = collections.all %}
          {% endif %}
          {% for product in menu_product_collection.products limit: section.settings.mobile_menu_product_limit %}
            <a class="header-menu-product" href="{{ product.url }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 300 }}"
                  srcset="{{ product.featured_image | image_url: width: 180 }} 180w, {{ product.featured_image | image_url: width: 300 }} 300w"
                  sizes="(max-width: 420px) 50vw, 180px"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                >
              {% endif %}
              <span class="header-menu-product__title">{{ product.title }}</span>
              {% if section.settings.show_mobile_menu_product_price %}
                <span class="header-menu-product__price">{{ product.price | money }}</span>
              {% endif %}
            </a>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </nav>
</aside>

<aside class="header-drawer header-drawer--search" data-header-panel="search" aria-label="Search drawer" aria-hidden="true">
  <div class="header-drawer__header">
    {% assign search_drawer_heading = 'Search' %}
    {% for block in section.blocks %}
      {% if block.type == 'drawer_title' and block.settings.drawer == 'search' and block.settings.title != blank %}
        {% assign search_drawer_heading = block.settings.title %}
      {% endif %}
    {% endfor %}
    <h2 class="header-drawer__title" {% for block in section.blocks %}{% if block.type == 'drawer_title' and block.settings.drawer == 'search' %}{{ block.shopify_attributes }}{% endif %}{% endfor %}>{{ search_drawer_heading }}</h2>
    <button class="header-drawer__close" type="button" data-header-close aria-label="Close search">&times;</button>
  </div>
  <div class="header-drawer__body">
    <form class="header-search-form" action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products..." aria-label="Search products" autocomplete="off">
      <button type="submit">Search</button>
    </form>
    <div class="header-search-results" data-header-search-results aria-live="polite"></div>
  </div>
</aside>

{% if shop.customer_accounts_enabled %}
  <aside class="header-drawer" data-header-panel="account" aria-label="Account drawer" aria-hidden="true">
    <div class="header-drawer__header">
      {% assign account_drawer_heading = 'Account' %}
      {% for block in section.blocks %}
        {% if block.type == 'drawer_title' and block.settings.drawer == 'account' and block.settings.title != blank %}
          {% assign account_drawer_heading = block.settings.title %}
        {% endif %}
      {% endfor %}
      <h2 class="header-drawer__title" {% for block in section.blocks %}{% if block.type == 'drawer_title' and block.settings.drawer == 'account' %}{{ block.shopify_attributes }}{% endif %}{% endfor %}>{{ account_drawer_heading }}</h2>
      <button class="header-drawer__close" type="button" data-header-close aria-label="Close account">&times;</button>
    </div>
    <div class="header-drawer__body">
      {% if customer %}
        <p>Hello, {{ customer.first_name | default: customer.name }}!</p>
        <a class="site-header__menu-link header-account-link" href="{{ routes.account_url }}">My account</a>
        <a class="site-header__menu-link header-account-link" href="{{ routes.account_logout_url }}">Log out</a>
      {% else %}
        <a class="site-header__menu-link header-account-link" href="{{ routes.account_login_url }}">Log in</a>
        <a class="site-header__menu-link header-account-link" href="{{ routes.account_register_url }}">Create account</a>
      {% endif %}
    </div>
  </aside>
{% endif %}

<aside class="header-drawer" data-header-panel="cart" aria-label="Cart drawer" aria-hidden="true">
  <div class="header-drawer__header">
    {% assign cart_drawer_heading = 'Your cart' %}
    {% for block in section.blocks %}
      {% if block.type == 'drawer_title' and block.settings.drawer == 'cart' and block.settings.title != blank %}
        {% assign cart_drawer_heading = block.settings.title %}
      {% endif %}
    {% endfor %}
    <h2 class="header-drawer__title" {% for block in section.blocks %}{% if block.type == 'drawer_title' and block.settings.drawer == 'cart' %}{{ block.shopify_attributes }}{% endif %}{% endfor %}>{{ cart_drawer_heading }}</h2>
    <button class="header-drawer__close" type="button" data-header-close aria-label="Close cart">&times;</button>
  </div>
  <div class="header-drawer__body" data-header-cart>
    <p>Loading cart...</p>
  </div>
</aside>

{% assign cart_empty_heading_block = section.settings.cart_empty_heading %}
{% assign cart_empty_text_block = section.settings.cart_empty_text %}
{% assign cart_empty_button_block = section.settings.cart_empty_button %}
{% assign cart_empty_button_link = routes.all_products_collection_url %}
{% for block in section.blocks %}
  {% if block.type == 'cart_empty_heading' %}{% assign cart_empty_heading_block = block.settings.heading %}{% endif %}
  {% if block.type == 'cart_empty_text' %}{% assign cart_empty_text_block = block.settings.text %}{% endif %}
  {% if block.type == 'cart_empty_button' %}
    {% assign cart_empty_button_block = block.settings.label %}
    {% if block.settings.link != blank %}{% assign cart_empty_button_link = block.settings.link %}{% endif %}
  {% endif %}
{% endfor %}

<script>
  (() => {
    const overlay = document.querySelector('[data-header-overlay]');
    const panels = document.querySelectorAll('[data-header-panel]');
    const cartContent = document.querySelector('[data-header-cart]');
    const cartCount = document.querySelector('.site-header__cart-count');
    const moneyFormat = {{ shop.money_format | json }};
    const searchInput = document.querySelector('[data-header-panel="search"] input[type="search"]');
    const searchResults = document.querySelector('[data-header-search-results]');
    let searchTimer;

    const formatMoney = (cents) => {
      if (window.Shopify && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents, moneyFormat);
      }
      return (cents / 100).toFixed(2);
    };

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    })[character]);

    const renderSearchResults = async (query) => {
      if (!searchResults) return;
      const normalizedQuery = query.trim();

      if (!normalizedQuery) {
        searchResults.innerHTML = '';
        return;
      }

      searchResults.innerHTML = '<p class="header-search-empty">Searching...</p>';

      try {
        const url = `/search/suggest.json?q=${encodeURIComponent(normalizedQuery)}&resources[type]=product&resources[limit]=6&resources[options][unavailable_products]=last`;
        const response = await fetch(url, { headers: { Accept: 'application/json' } });
        const data = await response.json();
        const products = data.resources?.results?.products || [];

        if (!products.length) {
          searchResults.innerHTML = '<p class="header-search-empty">No products found.</p>';
          return;
        }

        searchResults.innerHTML = products.map((product) => {
          const image = product.featured_image?.url || product.image || '';
          const price = product.price !== undefined && product.price !== null
            ? formatMoney(Number(product.price))
            : '';

          return `
            <a class="header-search-result" href="${escapeHtml(product.url)}">
              ${image ? `<img src="${escapeHtml(image)}" alt="${escapeHtml(product.title)}" loading="lazy">` : ''}
              <span class="header-search-result__title">${escapeHtml(product.title)}</span>
              ${price ? `<span class="header-search-result__price">${escapeHtml(price)}</span>` : ''}
            </a>
          `;
        }).join('');
      } catch (error) {
        searchResults.innerHTML = '<p class="header-search-empty">Unable to load products.</p>';
      }
    };

    const closeDrawers = () => {
      overlay?.classList.remove('is-open');
      panels.forEach((panel) => {
        panel.classList.remove('is-open');
        panel.setAttribute('aria-hidden', 'true');
      });
      document.body.style.overflow = '';
    };

    const openDrawer = async (name) => {
      closeDrawers();
      const panel = document.querySelector(`[data-header-panel="${name}"]`);
      if (!panel) return;

      panel.classList.add('is-open');
      panel.setAttribute('aria-hidden', 'false');
      overlay?.classList.add('is-open');
      document.body.style.overflow = 'hidden';

      if (name === 'search') {
        setTimeout(() => panel.querySelector('input[type="search"]')?.focus(), 100);
      }
      if (name === 'cart') await renderCart();
    };

    const renderCart = async (showLoading = true) => {
      if (!cartContent) return;
      if (showLoading) cartContent.innerHTML = '<p>Loading cart...</p>';

      try {
        const response = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
        const cart = await response.json();

        if (cartCount) cartCount.textContent = cart.item_count;
        if (!cart.items.length) {
          cartContent.innerHTML = `
            <div class="header-cart-empty">
              <h3 class="header-cart-empty__title">{{ cart_empty_heading_block | escape }}</h3>
              {% if cart_empty_text_block != blank %}
                <p class="header-cart-empty__text">{{ cart_empty_text_block | escape }}</p>
              {% endif %}
              <a class="header-cart-empty__button" href="{{ cart_empty_button_link }}">
                {{ cart_empty_button_block | escape | default: 'Shop products' }}
              </a>
            </div>
          `;
          return;
        }

        const items = cart.items.map((item) => `
          <div class="header-cart__item">
            ${item.image ? `<img src="${item.image}" alt="">` : ''}
            <div class="header-cart__item-details">
              <a href="${item.url}">${item.product_title}</a>
              ${item.variant_title ? `<div>${item.variant_title}</div>` : ''}
              <div>${formatMoney(item.final_line_price)}</div>
              <div class="header-cart__line-controls">
                <div class="header-cart__quantity" data-cart-line="${escapeHtml(item.key)}">
                  <button type="button" data-cart-change="-1" aria-label="Decrease quantity">&minus;</button>
                  <span>${item.quantity}</span>
                  <button type="button" data-cart-change="1" aria-label="Increase quantity">+</button>
                </div>
                <button class="header-cart__remove" type="button" data-cart-remove aria-label="Remove ${escapeHtml(item.product_title)}" title="Remove item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M3 6h18"></path>
                    <path d="M8 6V3h8v3"></path>
                    <path d="M19 6l-1 15H6L5 6"></path>
                    <path d="M10 10v7M14 10v7"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        `).join('');

        cartContent.innerHTML = `
          ${items}
          <div class="header-cart__footer">
            <strong>Subtotal: ${formatMoney(cart.total_price)}</strong>
            <a class="header-cart__checkout" href="/checkout">Checkout</a>
            <a href="/cart">View cart</a>
          </div>
        `;
      } catch (error) {
        cartContent.innerHTML = '<p>Unable to load the cart.</p>';
      }
    };

    window.themeOpenHeaderCart = () => openDrawer('cart');
    window.themeRefreshHeaderCart = renderCart;

    searchInput?.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        renderSearchResults(searchInput.value);
      }, 250);
    });

    document.querySelectorAll('[data-header-drawer]').forEach((button) => {
      button.addEventListener('click', () => openDrawer(button.dataset.headerDrawer));
    });
    document.querySelectorAll('[data-header-close]').forEach((button) => {
      button.addEventListener('click', closeDrawers);
    });
    cartContent?.addEventListener('click', async (event) => {
      const changeButton = event.target.closest('[data-cart-change]');
      const removeButton = event.target.closest('[data-cart-remove]');
      if (!changeButton && !removeButton) return;

      const quantityControl = changeButton?.closest('[data-cart-line]');
      const lineKey = quantityControl?.dataset.cartLine || removeButton?.closest('.header-cart__item-details')?.querySelector('[data-cart-line]')?.dataset.cartLine;
      if (!lineKey) return;

      let quantity = 0;
      if (changeButton && quantityControl) {
        quantity = Number(quantityControl.querySelector('span')?.textContent || 1) + Number(changeButton.dataset.cartChange);
      }

      const lineControl = changeButton?.closest('[data-cart-line]');
      const previousQuantity = lineControl?.querySelector('span');
      if (changeButton) {
        changeButton.disabled = true;
        changeButton.closest('[data-cart-line]')?.querySelectorAll('button').forEach((button) => {
          button.disabled = true;
        });
      }

      try {
        await fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ id: lineKey, quantity })
        });
        await renderCart(false);
      } catch (error) {
        await renderCart(false);
      }
    });
    overlay?.addEventListener('click', closeDrawers);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeDrawers();
    });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "My Store",
      "info": "Used when no logo image is selected"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Menu products"
    },
    {
      "type": "checkbox",
      "id": "show_menu_products",
      "label": "Show products in desktop menu dropdowns",
      "default": true
    },
    {
      "type": "collection",
      "id": "mobile_menu_collection",
      "label": "Menu products collection"
    },
    {
      "type": "text",
      "id": "mobile_menu_products_heading",
      "label": "Products heading",
      "default": "Featured products"
    },
    {
      "type": "range",
      "id": "mobile_menu_product_limit",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_mobile_menu_product_price",
      "label": "Show product prices",
      "default": true
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Header height",
      "min": 60,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Maximum content width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Empty cart drawer"
    },
    {
      "type": "text",
      "id": "cart_empty_heading",
      "label": "Empty cart heading",
      "default": "Your cart is empty"
    },
    {
      "type": "textarea",
      "id": "cart_empty_text",
      "label": "Empty cart text",
      "default": "Add something you love to get started."
    },
    {
      "type": "text",
      "id": "cart_empty_button",
      "label": "Empty cart button label",
      "default": "Shop products"
    }
  ],
  "blocks": [
    {
      "type": "brand_logo",
      "name": "Brand logo",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo image" },
        { "type": "text", "id": "logo_text", "label": "Logo text", "default": "My Store" }
      ]
    },
    {
      "type": "drawer_title",
      "name": "Drawer heading",
      "settings": [
        { "type": "select", "id": "drawer", "label": "Drawer", "default": "menu", "options": [
          { "value": "menu", "label": "Menu" },
          { "value": "search", "label": "Search" },
          { "value": "account", "label": "Account" },
          { "value": "cart", "label": "Cart" }
        ] },
        { "type": "text", "id": "title", "label": "Heading", "default": "Menu" }
      ]
    },
    {
      "type": "mobile_products_heading",
      "name": "Mobile product heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" }
      ]
    },
    {
      "type": "cart_empty_heading",
      "name": "Empty cart heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart is empty" }
      ]
    },
    {
      "type": "cart_empty_text",
      "name": "Empty cart text",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "Add something you love to get started." }
      ]
    },
    {
      "type": "cart_empty_button",
      "name": "Empty cart button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "Shop products" },
        { "type": "url", "id": "link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "brand_logo" },
        { "type": "mobile_products_heading" },
        { "type": "cart_empty_heading" },
        { "type": "cart_empty_text" },
        { "type": "cart_empty_button" }
      ]
    }
  ]
}
{% endschema %}