<style>
  .main-search { max-width: {{ section.settings.page_width }}px; margin: 0 auto; padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px; }
  .main-search__title { margin: 0 0 24px; font-size: clamp(32px,5vw,58px); }
  .main-search__form { display: grid; grid-template-columns: 1fr auto; gap: 10px; margin-bottom: 32px; }
  .main-search__input { height: 52px; border: 1px solid #ddd; padding: 0 14px; }
  .main-search__submit { min-width: 120px; border: 0; background: #111; color: #fff; font-weight: 700; }
  .main-search__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }},minmax(0,1fr)); gap: 16px; }
  .main-search-card { min-width: 0; }
  .main-search-card__image { position: relative; aspect-ratio: 1/1.05; margin-bottom: 12px; display:block; overflow:hidden; background:#f5f5f5; }
  .main-search-card__image > a { width:100%; height:100%; display:block; }
  .main-search-card__image img { width: 100%; height: 100%; object-fit: cover; }
  .main-search-card__title { margin: 0; font-size: 15px; }
  .main-search-card__title a { color: inherit; text-decoration: none; }
  .main-search-card__price { margin-top: 8px; font-weight: 700; }
  .main-search__empty { grid-column: 1/-1; padding: 60px 20px; text-align: center; }
  @media (max-width:749px) { .main-search { padding-inline:16px; } .main-search__grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px 10px; } }
</style>
<section class="main-search" {{ section.shopify_attributes }}>
  {% assign search_heading_rendered = false %}
  {% for block in section.blocks %}
    {% if block.type == 'heading' %}
      {% assign search_heading_rendered = true %}
      {% render 'theme-block-heading',
        block: block,
        heading: block.settings.heading,
        tag: 'h1',
        class_name: 'main-search__title',
        font_size: block.settings.font_size,
        color: block.settings.color,
        alignment: block.settings.alignment
      %}
    {% endif %}
  {% endfor %}
  {% if search_heading_rendered == false %}
    <h1 class="main-search__title">{{ section.settings.heading }}</h1>
  {% endif %}
  <form class="main-search__form" action="{{ routes.search_url }}" method="get">
    <input class="main-search__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder | escape }}">
    <button class="main-search__submit" type="submit">{{ section.settings.search_button_label }}</button>
  </form>
  {% if search.performed %}
    <p>{{ search.results_count }} results{% if search.terms != blank %} for "{{ search.terms }}"{% endif %}</p>
    {% paginate search.results by section.settings.results_per_page %}
      <div class="main-search__grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            <article class="main-search-card theme-product-card">
              <div class="main-search-card__image">
                <a href="{{ item.url }}">{% if item.featured_image %}<img src="{{ item.featured_image | image_url: width:700 }}" alt="{{ item.title | escape }}" width="700" height="735" loading="lazy">{% endif %}</a>
                {% render 'theme-product-hover-add', product: item %}
              </div>
              <h2 class="main-search-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h2>
              <div class="main-search-card__price">{{ item.price | money }}</div>
            </article>
          {% endif %}
        {% else %}
          <div class="main-search__empty">No products found.</div>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}<nav class="collection-pagination">{{ paginate | default_pagination }}</nav>{% endif %}
    {% endpaginate %}
  {% endif %}
</section>
{% schema %}
{
  "name": "Main search",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search" },
    { "type": "text", "id": "placeholder", "label": "Search placeholder", "default": "Search products..." },
    { "type": "text", "id": "search_button_label", "label": "Search button", "default": "Search" },
    { "type": "range", "id": "results_per_page", "min": 4, "max": 48, "step": 4, "label": "Results per page", "default": 16 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "range", "id": "page_width", "min": 960, "max": 1800, "step": 20, "unit": "px", "label": "Page width", "default": 1400 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Search heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Search" },
        { "type": "range", "id": "font_size", "min": 28, "max": 72, "step": 2, "unit": "px", "label": "Font size", "default": 58 },
        { "type": "color", "id": "color", "label": "Text color", "default": "#111111" },
        { "type": "select", "id": "alignment", "label": "Alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    }
  ],
  "max_blocks": 1,
  "presets": [{ "name": "Main search", "blocks": [{ "type": "heading" }] }]
}
{% endschema %}
