<style>
  .main-page { max-width: {{ section.settings.page_width }}px; margin: 0 auto; padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px; }
  .main-page__title { margin: 0 0 28px; font-size: clamp(32px,5vw,58px); line-height: 1; text-align: {{ section.settings.heading_alignment }}; }
  .main-page__content { max-width: 900px; margin: 0 auto; line-height: 1.75; }
  .main-page__content img { max-width: 100%; height: auto; }
  @media (max-width: 749px) { .main-page { padding-inline: 16px; } }
</style>
<section class="main-page" {{ section.shopify_attributes }}>
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'heading' %}
          <h1 class="main-page__title" style="font-size: {{ block.settings.font_size }}px; color: {{ block.settings.color }}; text-align: {{ block.settings.alignment }};" {{ block.shopify_attributes }}>{{ block.settings.heading | default: page.title }}</h1>
        {% when 'content' %}
          <div class="main-page__content" style="font-size: {{ block.settings.font_size }}px; color: {{ block.settings.color }};" {{ block.shopify_attributes }}>{{ block.settings.text | default: page.content }}</div>
      {% endcase %}
    {% endfor %}
  {% else %}
    <h1 class="main-page__title">{{ page.title }}</h1>
    <div class="main-page__content">{{ page.content }}</div>
  {% endif %}
</section>
{% schema %}
{
  "name": "Main page",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "page_width", "min": 800, "max": 1600, "step": 20, "unit": "px", "label": "Page width", "default": 1200 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
    ] }
  ],
  "blocks": [
    { "type": "heading", "name": "Page heading", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading override", "info": "Leave blank to use the page title" },
      { "type": "range", "id": "font_size", "min": 28, "max": 72, "step": 2, "unit": "px", "label": "Font size", "default": 58 },
      { "type": "color", "id": "color", "label": "Text color", "default": "#111111" },
      { "type": "select", "id": "alignment", "label": "Alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
      { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
      { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
    ]},
    { "type": "content", "name": "Page content", "limit": 1, "settings": [
      { "type": "richtext", "id": "text", "label": "Content override", "info": "Leave blank to use the Shopify page content" },
      { "type": "range", "id": "font_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 },
      { "type": "color", "id": "color", "label": "Text color", "default": "#111111" },
      { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
      { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
    ]}
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Main page", "blocks": [{ "type": "heading" }, { "type": "content" }] }]
}
{% endschema %}
