<style>
  .collection-recommended {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }

  .collection-recommended__heading {
    margin: 0 0 28px;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.1;
    text-align: {{ section.settings.heading_alignment }};
  }

  .collection-recommended__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 16px;
  }

  .collection-recommended-card {
    min-width: 0;
  }

  .collection-recommended-card__media {
    position: relative;
    aspect-ratio: 1 / 1.05;
    margin-bottom: 12px;
    display: block;
    overflow: hidden;
    background: #f5f5f5;
  }
  .collection-recommended-card__media > a {
    width: 100%;
    height: 100%;
    display: block;
  }

  .collection-recommended-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .collection-recommended-card:hover img {
    transform: scale(1.035);
  }

  .collection-recommended-card__title {
    margin: 0;
    font-size: 15px;
  }

  .collection-recommended-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .collection-recommended-card__price {
    margin-top: 7px;
    font-size: 14px;
    font-weight: 700;
  }

  .collection-recommended__empty {
    grid-column: 1 / -1;
    padding: 40px 20px;
    text-align: center;
    color: #777;
  }

  @media (max-width: 989px) {
    .collection-recommended__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .collection-recommended {
      padding-inline: 16px;
    }

    .collection-recommended__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 10px;
    }
  }
</style>

<section class="collection-recommended" {{ section.shopify_attributes }}>
  {% assign recommended_heading_rendered = false %}
  {% for block in section.blocks %}
    {% if block.type == 'heading' %}
      {% assign recommended_heading_rendered = true %}
      {% render 'theme-block-heading',
        block: block,
        heading: block.settings.heading,
        tag: 'h2',
        class_name: 'collection-recommended__heading',
        font_size: block.settings.font_size,
        color: block.settings.color,
        alignment: block.settings.alignment
      %}
    {% endif %}
  {% endfor %}
  {% if recommended_heading_rendered == false and section.settings.heading != blank %}
    <h2 class="collection-recommended__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="collection-recommended__grid">
    {% assign recommended_collection = section.settings.collection %}
    {% if recommended_collection == blank %}
      {% assign recommended_collection = collection %}
    {% endif %}

    {% if recommended_collection != blank and recommended_collection.products_count > 0 %}
      {% for product in recommended_collection.products limit: section.settings.products_to_show %}
        <article class="collection-recommended-card theme-product-card">
          <div class="collection-recommended-card__media">
            <a href="{{ product.url }}">
            {% if product.featured_media %}
              <img
                src="{{ product.featured_media | image_url: width: 700 }}"
                alt="{{ product.featured_media.alt | default: product.title | escape }}"
                width="700"
                height="735"
                loading="lazy"
              >
            {% endif %}
            </a>
            {% render 'theme-product-hover-add', product: product %}
          </div>
          <h3 class="collection-recommended-card__title">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h3>
          <div class="collection-recommended-card__price">{{ product.price | money }}</div>
        </article>
      {% endfor %}
    {% else %}
      <p class="collection-recommended__empty">No recommended products available.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collection picks",
  "tag": "section",
  "class": "section-collection-recommended",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 6, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "range", "id": "page_width", "min": 960, "max": 1800, "step": 20, "unit": "px", "label": "Page width", "default": 1400 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
        { "type": "range", "id": "font_size", "min": 24, "max": 64, "step": 2, "unit": "px", "label": "Font size", "default": 42 },
        { "type": "color", "id": "color", "label": "Text color", "default": "#111111" },
        { "type": "select", "id": "alignment", "label": "Alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    }
  ],
  "max_blocks": 1,
  "presets": [
    { "name": "Collection picks", "blocks": [{ "type": "heading" }] }
  ]
}
{% endschema %}
