<style>
  .announcement-bar {
    width: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .announcement-bar__inner {
    min-height: {{ section.settings.bar_height }}px;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.text_alignment }};
    gap: 12px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }

  .announcement-bar__text {
    margin: 0;
    font-size: {{ section.settings.text_size }}px;
    font-weight: 600;
    font-family: {{ section.settings.font_family }};
  }

  .announcement-bar__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .announcement-bar__slider {
    position: relative;
    min-height: {{ section.settings.bar_height }}px;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 40px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .announcement-bar__slides {
    position: relative;
    height: {{ section.settings.bar_height }}px;
    min-height: {{ section.settings.bar_height }}px;
  }

  .announcement-bar__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.text_alignment }};
    text-align: center;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .announcement-bar__slide.is-active {
    visibility: visible;
    opacity: 1;
  }

  .announcement-bar__slide .announcement-bar__text {
    font-family: {{ section.settings.font_family }};
  }

  .announcement-bar__slide .announcement-bar__link {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.text_alignment }};
    text-decoration: underline;
  }

  .announcement-bar__control {
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: transparent;
    color: inherit;
    font-size: 24px;
    cursor: pointer;
  }

  @media (max-width: 749px) {
    .announcement-bar__slider {
      grid-template-columns: 32px minmax(0, 1fr) 32px;
      padding: 0 8px;
    }

    .announcement-bar__control {
      width: 32px;
      font-size: 20px;
    }

    .announcement-bar__slide,
    .announcement-bar__slide .announcement-bar__link,
    .announcement-bar__inner {
      justify-content: center;
      text-align: center;
    }

    .announcement-bar {
      background: {{ section.settings.mobile_background_color }};
      color: {{ section.settings.mobile_text_color }};
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .announcement-bar__inner,
    .announcement-bar__slider,
    .announcement-bar__slides,
    .announcement-bar__slide {
      min-height: {{ section.settings.mobile_bar_height }}px;
    }

    .announcement-bar__slides,
    .announcement-bar__slide {
      height: {{ section.settings.mobile_bar_height }}px;
    }

    .announcement-bar__text {
      font-size: {{ section.settings.mobile_text_size }}px;
      font-family: {{ section.settings.mobile_font_family }};
    }
  }

  @media (min-width: 750px) and (max-width: 1280px) {
    .announcement-bar__slide,
    .announcement-bar__slide .announcement-bar__link,
    .announcement-bar__inner {
      justify-content: center;
      text-align: center;
    }

    .announcement-bar {
      background: {{ section.settings.tablet_background_color }};
      color: {{ section.settings.tablet_text_color }};
      padding-top: {{ section.settings.tablet_padding_top }}px;
      padding-bottom: {{ section.settings.tablet_padding_bottom }}px;
    }

    .announcement-bar__inner,
    .announcement-bar__slider,
    .announcement-bar__slides,
    .announcement-bar__slide {
      min-height: {{ section.settings.tablet_bar_height }}px;
    }

    .announcement-bar__slides,
    .announcement-bar__slide {
      height: {{ section.settings.tablet_bar_height }}px;
    }

    .announcement-bar__text {
      font-size: {{ section.settings.tablet_text_size }}px;
      font-family: {{ section.settings.tablet_font_family }};
    }
  }

  {% unless section.settings.show_arrows_desktop %}
    @media (min-width: 1281px) {
      .announcement-bar__control {
        visibility: hidden;
      }
    }
  {% endunless %}

  {% unless section.settings.show_arrows_tablet %}
    @media (min-width: 750px) and (max-width: 1280px) {
      .announcement-bar__control {
        visibility: hidden;
      }
    }
  {% endunless %}

  {% unless section.settings.show_arrows_mobile %}
    @media (max-width: 749px) {
      .announcement-bar__control {
        visibility: hidden;
      }
    }
  {% endunless %}
</style>

{% if section.blocks.size > 0 %}
  <div class="announcement-bar" role="region" aria-label="Announcements">
    {% if section.blocks.size == 1 %}
      <div class="announcement-bar__inner">
        {% for block in section.blocks %}
          {% if block.settings.text != blank %}
            {% if block.settings.link != blank %}
              <a class="announcement-bar__link" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
                <p class="announcement-bar__text">{{ block.settings.text }}</p>
              </a>
            {% else %}
              <p class="announcement-bar__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="announcement-bar__slider" data-announcement-slider data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.change_speed }}">
        <button class="announcement-bar__control" type="button" data-announcement-prev aria-label="Previous announcement" {% unless section.settings.show_arrows_desktop %}data-hide-desktop{% endunless %}>&lsaquo;</button>
        <div class="announcement-bar__slides" aria-live="polite">
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}
              <div class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}" data-announcement-slide {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}
                  <a class="announcement-bar__link" href="{{ block.settings.link }}">
                    <p class="announcement-bar__text">{{ block.settings.text }}</p>
                  </a>
                {% else %}
                  <p class="announcement-bar__text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <button class="announcement-bar__control" type="button" data-announcement-next aria-label="Next announcement">&rsaquo;</button>

      </div>
    {% endif %}
  </div>
{% endif %}

<script>
  (() => {
    document.querySelectorAll('[data-announcement-slider]').forEach((slider) => {
      if (slider.dataset.initialized === 'true') return;
      slider.dataset.initialized = 'true';

      const slides = Array.from(slider.querySelectorAll('[data-announcement-slide]'));
      const previousButton = slider.querySelector('[data-announcement-prev]');
      const nextButton = slider.querySelector('[data-announcement-next]');
      let currentIndex = 0;
      let autoplayTimer;
      let touchStartX = 0;

      if (!slides.length) return;

      const showSlide = (index) => {
        currentIndex = (index + slides.length) % slides.length;
        slides.forEach((slide, slideIndex) => {
          slide.classList.toggle('is-active', slideIndex === currentIndex);
        });
      };

      const stopAutoplay = () => {
        if (autoplayTimer) window.clearInterval(autoplayTimer);
      };

      const startAutoplay = () => {
        stopAutoplay();
        if (slider.dataset.autoplay !== 'true') return;

        const speed = Math.max(Number(slider.dataset.speed) || 5, 2) * 1000;
        autoplayTimer = window.setInterval(() => showSlide(currentIndex + 1), speed);
      };

      previousButton?.addEventListener('click', () => {
        showSlide(currentIndex - 1);
        startAutoplay();
      });

      nextButton?.addEventListener('click', () => {
        showSlide(currentIndex + 1);
        startAutoplay();
      });

      slider.addEventListener('touchstart', (event) => {
        touchStartX = event.changedTouches[0].clientX;
      }, { passive: true });

      slider.addEventListener('touchend', (event) => {
        const touchEndX = event.changedTouches[0].clientX;
        const swipeDistance = touchStartX - touchEndX;

        if (Math.abs(swipeDistance) < 40) return;

        if (swipeDistance > 0) {
          showSlide(currentIndex + 1);
        } else {
          showSlide(currentIndex - 1);
        }
        startAutoplay();
      }, { passive: true });

      slider.addEventListener('mouseenter', stopAutoplay);
      slider.addEventListener('mouseleave', startAutoplay);
      showSlide(0);
      startAutoplay();
    });
  })();
</script>

