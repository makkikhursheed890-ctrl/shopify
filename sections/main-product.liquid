<style>
  .main-product {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .main-product__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    gap: {{ section.settings.desktop_gap }}px;
    align-items: start;
  }

  .product-gallery {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: {{ section.settings.gallery_gap }}px;
    min-width: 0;
  }

  .product-gallery__thumbs {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .product-gallery__thumb {
    width: 76px;
    aspect-ratio: 1;
    border: 1px solid transparent;
    padding: 0;
    background: #f6f6f6;
    cursor: pointer;
    overflow: hidden;
  }

  .product-gallery__thumb.is-active {
    border-color: #111;
  }

  .product-gallery__thumb img,
  .product-gallery__main img,
  .product-gallery__main video,
  .product-gallery__main model-viewer {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-gallery__main {
    aspect-ratio: 1 / 1.05;
    background: #f6f6f6;
  }

  .product-gallery__main img {
    display: block;
  }

  .product-info {
    position: sticky;
    top: 24px;
    padding-top: {{ section.settings.details_spacing }}px;
  }

  .product-info__vendor {
    margin: 0 0 10px;
    color: #777;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .product-info__title {
    margin: 0 0 14px;
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1.08;
  }

  .product-info__price {
    margin-bottom: 20px;
    font-size: 22px;
    font-weight: 700;
  }

  .product-info__compare-price {
    margin-left: 8px;
    color: #777;
    font-size: 16px;
    font-weight: 400;
    text-decoration: line-through;
  }

  .product-info__description {
    margin: 20px 0;
    line-height: 1.7;
  }

  .product-form__variants {
    display: grid;
    gap: 16px;
    margin-bottom: 18px;
  }

  .product-option {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .product-option legend {
    margin-bottom: 9px;
    font-weight: 700;
  }

  .product-option__values {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .product-option__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .product-option__label {
    min-width: 44px;
    min-height: 44px;
    box-sizing: border-box;
    border: 1px solid #ccc;
    padding: 10px 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .product-option__input:checked + .product-option__label {
    border-width: 2px;
    border-color: #111;
  }

  .product-option__input:disabled + .product-option__label {
    border-style: dashed;
    color: #999;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  .product-quantity {
    margin-bottom: 12px;
  }

  .product-quantity label {
    display: block;
    margin-bottom: 8px;
    font-weight: 700;
  }

  .product-quantity__control {
    width: 150px;
    height: 48px;
    border: 1px solid #ccc;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 48px;
  }

  .product-quantity__control button,
  .product-quantity__control input {
    border: 0;
    background: transparent;
    text-align: center;
  }

  .product-quantity__control button {
    cursor: pointer;
    font-size: 20px;
  }

  .product-quantity__control input {
    width: 100%;
    min-width: 0;
    appearance: textfield;
  }

  .product-form__submit,
  .product-form__buy-now {
    width: 100%;
    height: 54px;
    border: 0;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
  }

  .product-form__submit {
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text }};
  }

  .product-form__submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .product-form__buy-now {
    margin-top: 10px;
    border: 1px solid #111;
    background: transparent;
    color: #111;
  }

  .product-info__pickup {
    margin-top: 16px;
  }

  @media (max-width: 989px) {
    .main-product {
      padding-inline: 16px;
    }

    .main-product__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .product-info {
      position: static;
    }
  }

  @media (max-width: 749px) {
    .main-product {
      padding-inline: 0;
    }

    .product-gallery {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .product-gallery__thumbs {
      order: 2;
      flex-direction: row;
      overflow-x: auto;
      padding: 10px;
    }

    .product-gallery__thumb {
      width: 64px;
      flex: 0 0 64px;
    }

    .product-gallery__main {
      order: 1;
      aspect-ratio: 1;
    }

    .product-info {
      padding: 8px 16px 24px;
    }
  }
</style>

{% if product == blank %}
  <div class="main-product">
    <h1>Product not found</h1>
    <p>The requested product is not available.</p>
    <a href="{{ routes.all_products_collection_url }}">View all products</a>
  </div>
{% else %}
<div class="main-product" {{ section.shopify_attributes }}>
  <div class="main-product__grid">
    <div class="product-gallery" data-product-gallery>
      {% if product.media.size > 0 %}
        <div class="product-gallery__thumbs" aria-label="Product media">
          {% for media in product.media %}
            <button
              class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
              type="button"
              data-gallery-media="{{ forloop.index0 }}"
              data-gallery-media-type="{{ media.media_type }}"
              data-gallery-url="{{ media.preview_image | image_url: width: 1200 }}"
              data-gallery-alt="{{ media.alt | default: product.title | escape }}"
              aria-label="View media {{ forloop.index }}"
            >
              {% if media.media_type == 'image' %}
                <img src="{{ media.preview_image | image_url: width: 160 }}" alt="{{ media.alt | escape }}" loading="lazy" width="76" height="76">
              {% elsif media.media_type == 'video' %}
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy' }}
              {% else %}
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy' }}
              {% endif %}
            </button>
          {% endfor %}
        </div>

        <div class="product-gallery__main" data-gallery-main>
          {% assign first_media = product.media.first %}
          {% if first_media.media_type == 'image' %}
            <img
              data-gallery-main-image
              src="{{ first_media.preview_image | image_url: width: 1200 }}"
              srcset="{{ first_media.preview_image | image_url: width: 600 }} 600w, {{ first_media.preview_image | image_url: width: 900 }} 900w, {{ first_media.preview_image | image_url: width: 1200 }} 1200w"
              sizes="(max-width: 989px) 100vw, 55vw"
              alt="{{ first_media.alt | default: product.title | escape }}"
              width="{{ first_media.preview_image.width }}"
              height="{{ first_media.preview_image.height }}"
            >
          {% else %}
            {{ first_media | media_tag: image_size: '1200x', autoplay: false, controls: true }}
          {% endif %}
        </div>
      {% else %}
        <div class="product-gallery__main"></div>
      {% endif %}
    </div>

    <div class="product-info">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'vendor' %}
            <p class="product-info__vendor" style="font-size: {{ block.settings.font_size }}px; color: {{ block.settings.color }};" {{ block.shopify_attributes }}>{{ block.settings.text | default: product.vendor }}</p>
          {% elsif block.type == 'title' %}
            <h1 class="product-info__title" style="font-size: {{ block.settings.font_size }}px; color: {{ block.settings.color }}; text-align: {{ block.settings.alignment }};" {{ block.shopify_attributes }}>{{ block.settings.heading | default: product.title }}</h1>
          {% elsif block.type == 'price' %}
            <div class="product-info__price" data-product-price style="font-size: {{ block.settings.font_size }}px; color: {{ block.settings.color }}; text-align: {{ block.settings.alignment }};" {{ block.shopify_attributes }}>
              <span>{{ product.selected_or_first_available_variant.price | money }}</span>
              {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
                <span class="product-info__compare-price">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
              {% endif %}
            </div>
          {% elsif block.type == 'description' %}
            <div class="product-info__description" style="font-size: {{ block.settings.font_size }}px; color: {{ block.settings.color }};" {{ block.shopify_attributes }}>{{ block.settings.text | default: product.description }}</div>
          {% elsif block.type == 'text' %}
            <div class="product-info__description" style="font-size: {{ block.settings.font_size }}px; color: {{ block.settings.color }}; text-align: {{ block.settings.alignment }};" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {% elsif block.type == 'link' %}
            {% if block.settings.label != blank and block.settings.link != blank %}
              <a class="product-form__buy-now" style="display: grid; margin-top: {{ block.settings.margin_top }}px; background: {{ block.settings.background }}; color: {{ block.settings.color }};" href="{{ block.settings.link }}" {{ block.shopify_attributes }} {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ block.settings.label }}</a>
            {% endif %}
          {% endif %}
        {% endfor %}
      {% else %}
        {% if section.settings.show_vendor and product.vendor != blank %}
          <p class="product-info__vendor">{{ product.vendor }}</p>
        {% endif %}
        <h1 class="product-info__title">{{ product.title }}</h1>
        <div class="product-info__price" data-product-price>
          <span>{{ product.selected_or_first_available_variant.price | money }}</span>
          {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
            <span class="product-info__compare-price">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
          {% endif %}
        </div>
      {% endif %}

      {% form 'product', product, class: 'product-form', data-product-form: '' %}
        <select name="id" data-product-variant-id class="visually-hidden" aria-label="Variant">
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title }} - {{ variant.price | money }}
            </option>
          {% endfor %}
        </select>

        {% if product.has_only_default_variant == false %}
          <div class="product-form__variants">
            {% for option in product.options_with_values %}
              <fieldset class="product-option" data-product-option="{{ forloop.index0 }}">
                <legend>{{ option.name }}</legend>
                <div class="product-option__values">
                  {% for value in option.values %}
                    <input
                      class="product-option__input"
                      type="radio"
                      name="option{{ forloop.parentloop.index }}"
                      id="Option-{{ section.id }}-{{ option.name | handle }}-{{ value | handle }}"
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}
                    >
                    <label
                      class="product-option__label"
                      for="Option-{{ section.id }}-{{ option.name | handle }}-{{ value | handle }}"
                    >
                      {{ value }}
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.show_quantity %}
          <div class="product-quantity">
            <label for="Quantity-{{ section.id }}">Quantity</label>
            <div class="product-quantity__control">
              <button type="button" data-quantity-minus aria-label="Decrease quantity">&minus;</button>
              <input id="Quantity-{{ section.id }}" name="quantity" type="number" value="1" min="1" inputmode="numeric">
              <button type="button" data-quantity-plus aria-label="Increase quantity">&plus;</button>
            </div>
          </div>
        {% endif %}

        <button
          class="product-form__submit"
          type="submit"
          name="add"
          data-product-submit
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
          {% if product.selected_or_first_available_variant.available %}
            Add to cart
          {% else %}
            Sold out
          {% endif %}
        </button>

        {% if section.settings.show_dynamic_checkout %}
          <button class="product-form__buy-now" type="button" data-buy-now>Buy it now</button>
        {% endif %}
      {% endform %}

      {% if section.blocks.size == 0 %}
        <div class="product-info__description">{{ product.description }}</div>
      {% endif %}
    </div>
  </div>
</div>

<script type="application/json" data-product-json>
  {{ product.variants | json }}
</script>

<script>
  (() => {
    const form = document.querySelector('[data-product-form]');
    if (!form) return;

    const variantSelect = form.querySelector('[data-product-variant-id]');
    const variantJson = document.querySelector('[data-product-json]');
    const variants = variantJson ? JSON.parse(variantJson.textContent) : [];
    const priceElement = document.querySelector('[data-product-price]');
    const submitButton = form.querySelector('[data-product-submit]');
    const quantityInput = form.querySelector('input[name="quantity"]');
    const moneyFormat = {{ shop.money_format | json }};

    const formatMoney = (cents) => {
      if (window.Shopify && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents, moneyFormat);
      }
      return (cents / 100).toFixed(2);
    };

    const getSelectedOptions = () => {
      const optionInputs = form.querySelectorAll('.product-option__input:checked');
      return Array.from(optionInputs).map((input) => input.value);
    };

    const syncVariant = () => {
      const selectedOptions = getSelectedOptions();
      const variant = variants.find((item) => {
        if (selectedOptions.length === 0) return item.id.toString() === variantSelect.value;
        return item.options.every((option, index) => option === selectedOptions[index]);
      });

      if (!variant) return;
      variantSelect.value = variant.id;

      const currentUrl = new URL(window.location.href);
      currentUrl.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', currentUrl);

      if (priceElement) {
        const comparePrice = variant.compare_at_price > variant.price
          ? `<span class="product-info__compare-price">${formatMoney(variant.compare_at_price)}</span>`
          : '';
        priceElement.innerHTML = `<span>${formatMoney(variant.price)}</span>${comparePrice}`;
      }

      if (submitButton) {
        submitButton.disabled = !variant.available;
        submitButton.textContent = variant.available ? 'Add to cart' : 'Sold out';
      }

      const matchingMedia = variant.featured_media || variant.featured_image;
      if (matchingMedia && matchingMedia.preview_image?.src) {
        setGalleryImage(matchingMedia.preview_image.src);
      }
    };

    const setGalleryImage = (url) => {
      const main = document.querySelector('[data-gallery-main]');
      if (!main || !url) return;
      const image = main.querySelector('img');
      if (image) {
        image.src = url;
        image.srcset = '';
      } else {
        main.innerHTML = `<img data-gallery-main-image src="${url}" alt="Product image">`;
      }
    };

    form.querySelectorAll('.product-option__input').forEach((input) => {
      input.addEventListener('change', syncVariant);
    });

    document.querySelectorAll('[data-gallery-media]').forEach((button) => {
      button.addEventListener('click', () => {
        document.querySelectorAll('[data-gallery-media]').forEach((item) => item.classList.remove('is-active'));
        button.classList.add('is-active');
        if (button.dataset.galleryMediaType === 'image' && button.dataset.galleryUrl) {
          const main = document.querySelector('[data-gallery-main]');
          const image = main?.querySelector('[data-gallery-main-image]') || main?.querySelector('img');
          if (image) {
            image.src = button.dataset.galleryUrl;
            image.srcset = '';
            image.alt = button.dataset.galleryAlt || '';
          } else if (main) {
            const newImage = document.createElement('img');
            newImage.dataset.galleryMainImage = '';
            newImage.src = button.dataset.galleryUrl;
            newImage.alt = button.dataset.galleryAlt || 'Product image';
            main.replaceChildren(newImage);
          }
        }
      });
    });

    document.querySelector('[data-quantity-minus]')?.addEventListener('click', () => {
      quantityInput.value = Math.max(1, Number(quantityInput.value) - 1);
    });

    document.querySelector('[data-quantity-plus]')?.addEventListener('click', () => {
      quantityInput.value = Math.max(1, Number(quantityInput.value) + 1);
    });

    form.addEventListener('submit', async (event) => {
      if (!submitButton?.disabled) {
        event.preventDefault();
        submitButton.disabled = true;
        submitButton.textContent = 'Adding...';

        const formData = new FormData(form);
        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData
          });
          if (!response.ok) throw new Error('Unable to add product');
          submitButton.textContent = 'Added to cart';
          window.location.reload();
        } catch (error) {
          submitButton.textContent = 'Try again';
          submitButton.disabled = false;
        }
      }
    });

    document.querySelector('[data-buy-now]')?.addEventListener('click', async () => {
      const formData = new FormData(form);
      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData
        });
        if (!response.ok) throw new Error('Unable to add product');
        window.location.href = '/checkout';
      } catch (error) {
        alert('Unable to start checkout. Please try again.');
      }
    });
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Main product",
  "tag": "section",
  "class": "main-product-section",
  "settings": [
    {
      "type": "range",
      "id": "page_width",
      "label": "Maximum page width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop column gap",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "gallery_gap",
      "label": "Gallery image and thumbnail gap",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "details_spacing",
      "label": "Product details top spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Add to cart background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Add to cart text",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show buy now button",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Vendor override", "info": "Leave blank to use the product vendor" },
        { "type": "range", "id": "font_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 13 },
        { "type": "color", "id": "color", "label": "Text color", "default": "#777777" },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    },
    {
      "type": "title",
      "name": "Product title",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Title override", "info": "Leave blank to use the product title" },
        { "type": "range", "id": "font_size", "min": 24, "max": 60, "step": 2, "unit": "px", "label": "Font size", "default": 44 },
        { "type": "color", "id": "color", "label": "Text color", "default": "#111111" },
        { "type": "select", "id": "alignment", "label": "Alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "font_size", "min": 14, "max": 36, "step": 1, "unit": "px", "label": "Font size", "default": 22 },
        { "type": "color", "id": "color", "label": "Text color", "default": "#111111" },
        { "type": "select", "id": "alignment", "label": "Alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    },
    {
      "type": "description",
      "name": "Product description",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Description override", "info": "Leave blank to use the product description" },
        { "type": "range", "id": "font_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 },
        { "type": "color", "id": "color", "label": "Text color", "default": "#111111" },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    },
    {
      "type": "text",
      "name": "Custom text",
