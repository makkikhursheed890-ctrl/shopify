<style>
  .site-footer {
    width: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .site-footer__inner {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }

  .site-footer__main {
    display: grid;
    grid-template-columns: minmax(220px, 1.35fr) repeat({{ section.blocks.size | at_most: 4 }}, minmax(150px, 1fr));
    gap: 48px;
  }

  .site-footer__brand {
    max-width: 360px;
  }

  .site-footer__logo {
    display: inline-block;
    margin-bottom: 16px;
    color: inherit;
    font-size: 26px;
    font-weight: 800;
    text-decoration: none;
  }

  .site-footer__logo-image {
    display: block;
    width: {{ section.settings.logo_width }}px;
    max-width: 100%;
    height: auto;
  }

  .site-footer__feature-image-link {
    width: 100%;
    max-width: 360px;
    margin-bottom: 18px;
    display: block;
  }

  .site-footer__feature-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    display: block;
    object-fit: cover;
    border-radius: 4px;
  }

  .site-footer__description {
    margin: 0;
    line-height: 1.7;
    opacity: 0.78;
  }

  .site-footer__socials {
    display: flex;
    gap: 12px;
    margin-top: 20px;
  }

  .site-footer__social {
    width: 38px;
    height: 38px;
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: inherit;
    text-decoration: none;
    font-size: 12px;
    font-weight: 800;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .site-footer__social:hover {
    background: {{ section.settings.text_color }};
    color: {{ section.settings.background_color }};
  }

  .site-footer__heading {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .site-footer__menu {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__menu li + li {
    margin-top: 11px;
  }

  .site-footer__menu a {
    color: inherit;
    line-height: 1.5;
    text-decoration: none;
    opacity: 0.78;
  }

  .site-footer__menu a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .site-footer__newsletter {
    margin-top: 36px;
    max-width: 500px;
  }

  .site-footer__newsletter-text {
    margin: 0 0 14px;
    line-height: 1.7;
    opacity: 0.78;
  }

  .footer-newsletter-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .footer-newsletter-form input {
    min-width: 0;
    height: 50px;
    box-sizing: border-box;
    border: 1px solid {{ section.settings.border_color }};
    border-right: 0;
    border-radius: 0;
    padding: 0 14px;
    background: transparent;
    color: inherit;
  }

  .footer-newsletter-form input::placeholder {
    color: inherit;
    opacity: 0.65;
  }

  .footer-newsletter-form button {
    height: 50px;
    border: 1px solid {{ section.settings.button_background }};
    padding: 0 22px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text }};
    font-weight: 700;
    cursor: pointer;
  }

  .site-footer__bottom {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid {{ section.settings.border_color }};
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .site-footer__copyright {
    margin: 0;
    font-size: 13px;
    opacity: 0.72;
  }

  .site-footer__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 7px;
  }

  .site-footer__payment {
    width: 38px;
    height: 24px;
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 3px;
    display: grid;
    place-items: center;
    padding: 0;
    box-sizing: border-box;
    overflow: hidden;
    background: #ffffff;
  }

  .site-footer__payment svg {
    width: 38px;
    height: 24px;
    display: block;
  }

  @media (max-width: 989px) {
    .site-footer__main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 749px) {
    .site-footer__inner {
      padding-inline: 16px;
    }

    .site-footer__main {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .site-footer__brand {
      grid-column: auto;
    }

    .site-footer__newsletter {
      margin-top: 28px;
    }

    .footer-newsletter-form {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .footer-newsletter-form input {
      border-right: 1px solid {{ section.settings.border_color }};
    }

    .site-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-footer__payments {
      justify-content: flex-start;
    }
  }
</style>

<footer class="site-footer" {{ section.shopify_attributes }}>
  <div class="site-footer__inner">
    <div class="site-footer__main">
      <div class="site-footer__brand">
        {% assign footer_feature_image_rendered = false %}
        {% for block in section.blocks %}
          {% if block.type == 'footer_image' %}
            {% assign footer_feature_image_rendered = true %}
            {% if block.settings.image != blank %}
              {% if block.settings.link != blank %}<a class="site-footer__feature-image-link" href="{{ block.settings.link }}" {{ block.shopify_attributes }} {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{% else %}<div class="site-footer__feature-image-link" {{ block.shopify_attributes }}>{% endif %}
                <img class="site-footer__feature-image" src="{{ block.settings.image | image_url: width: 720 }}" alt="{{ block.settings.image.alt | default: shop.name | escape }}" width="720" height="450" loading="lazy">
              {% if block.settings.link != blank %}</a>{% else %}</div>{% endif %}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if footer_feature_image_rendered == false and section.settings.footer_image != blank %}
          <img class="site-footer__feature-image" src="{{ section.settings.footer_image | image_url: width: 720 }}" alt="{{ section.settings.footer_image.alt | default: shop.name | escape }}" width="720" height="450" loading="lazy">
        {% endif %}

        {% assign footer_logo_rendered = false %}
        {% for block in section.blocks %}
          {% if block.type == 'brand' %}
            {% assign footer_logo_rendered = true %}
            <a class="site-footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}" {{ block.shopify_attributes }}>
              {% if block.settings.logo != blank %}
                <img class="site-footer__logo-image" src="{{ block.settings.logo | image_url: width: 400 }}" alt="{{ block.settings.logo.alt | default: shop.name | escape }}" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}">
              {% else %}
                {{ block.settings.logo_text | default: shop.name }}
              {% endif %}
            </a>
          {% endif %}
        {% endfor %}
        {% if footer_logo_rendered == false %}
          <a class="site-footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
            {% if section.settings.logo != blank %}
            <img
              class="site-footer__logo-image"
              src="{{ section.settings.logo | image_url: width: 400 }}"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
            >
          {% else %}
            {{ section.settings.logo_text | default: shop.name }}
          {% endif %}
          </a>
        {% endif %}

        {% assign footer_description_rendered = false %}
        {% for block in section.blocks %}
          {% if block.type == 'description' %}
            {% assign footer_description_rendered = true %}
            {% render 'theme-block-rich-text',
              block: block,
              text: block.settings.text,
              class_name: 'site-footer__description',
              font_size: block.settings.font_size,
              color: block.settings.color
            %}
          {% endif %}
        {% endfor %}
        {% if footer_description_rendered == false and section.settings.description != blank %}
          <p class="site-footer__description">{{ section.settings.description }}</p>
        {% endif %}

        {% assign footer_social_rendered = false %}
        {% for block in section.blocks %}
          {% if block.type == 'social_link' %}
            {% assign footer_social_rendered = true %}
          {% endif %}
        {% endfor %}
        {% if footer_social_rendered == false and section.settings.show_socials %}
          <div class="site-footer__socials" aria-label="Social media">
            {% if section.settings.facebook_url != blank %}
              <a class="site-footer__social" href="{{ section.settings.facebook_url }}" aria-label="Facebook">FB</a>
            {% endif %}
            {% if section.settings.instagram_url != blank %}
              <a class="site-footer__social" href="{{ section.settings.instagram_url }}" aria-label="Instagram">IG</a>
            {% endif %}
            {% if section.settings.tiktok_url != blank %}
              <a class="site-footer__social" href="{{ section.settings.tiktok_url }}" aria-label="TikTok">TT</a>
            {% endif %}
            {% if section.settings.youtube_url != blank %}
              <a class="site-footer__social" href="{{ section.settings.youtube_url }}" aria-label="YouTube">YT</a>
            {% endif %}
          </div>
        {% endif %}
        {% if footer_social_rendered %}
          <div class="site-footer__socials" aria-label="Social media">
            {% for block in section.blocks %}
              {% if block.type == 'social_link' and block.settings.url != blank %}
                <a class="site-footer__social" href="{{ block.settings.url }}" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }} {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ block.settings.label | slice: 0, 2 | upcase }}</a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% assign footer_newsletter_rendered = false %}
        {% for block in section.blocks %}
          {% if block.type == 'newsletter' %}
            {% assign footer_newsletter_rendered = true %}
          {% endif %}
        {% endfor %}
        {% if footer_newsletter_rendered %}
          {% for block in section.blocks %}
            {% if block.type == 'newsletter' %}
              <div class="site-footer__newsletter" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}<h2 class="site-footer__heading">{{ block.settings.heading }}</h2>{% endif %}
                {% if block.settings.text != blank %}<p class="site-footer__newsletter-text">{{ block.settings.text }}</p>{% endif %}
                {% form 'customer', class: 'footer-newsletter-form' %}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <input type="email" name="contact[email]" placeholder="{{ block.settings.placeholder }}" aria-label="Email address" required>
                  <button type="submit">{{ block.settings.button_label }}</button>
                {% endform %}
              </div>
            {% endif %}
          {% endfor %}
        {% elsif section.settings.show_newsletter %}
          <div class="site-footer__newsletter">
            {% if section.settings.newsletter_heading != blank %}
              <h2 class="site-footer__heading">{{ section.settings.newsletter_heading }}</h2>
            {% endif %}
            {% if section.settings.newsletter_text != blank %}
              <p class="site-footer__newsletter-text">{{ section.settings.newsletter_text }}</p>
            {% endif %}

            {% form 'customer', class: 'footer-newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input type="email" name="contact[email]" placeholder="{{ section.settings.newsletter_placeholder }}" aria-label="Email address" required>
              <button type="submit">{{ section.settings.newsletter_button }}</button>

              {% if form.posted_successfully? %}
                <p class="site-footer__newsletter-text">Thank you for subscribing.</p>
              {% elsif form.errors %}
                {{ form.errors | default_errors }}
              {% endif %}
            {% endform %}
          </div>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'menu' %}
          <div class="site-footer__column" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.menu != blank %}
              <ul class="site-footer__menu">
                {% for link in block.settings.menu.links %}
                  <li>
                    <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="site-footer__bottom">
      {% assign footer_copyright_rendered = false %}
      {% assign footer_payments_rendered = false %}
      {% for block in section.blocks %}
        {% if block.type == 'copyright' %}
          {% assign footer_copyright_rendered = true %}
          {% assign current_year = 'now' | date: '%Y' %}
          <p class="site-footer__copyright" {{ block.shopify_attributes }}>{{ block.settings.text | replace: '[year]', current_year }}</p>
        {% endif %}
        {% if block.type == 'payment_icons' %}
          {% assign footer_payments_rendered = true %}
        {% endif %}
      {% endfor %}
      {% if footer_copyright_rendered == false %}
        <p class="site-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}
        </p>
      {% endif %}

      {% if footer_payments_rendered %}
        {% for block in section.blocks %}
          {% if block.type == 'payment_icons' %}
            <div class="site-footer__payments" aria-label="Accepted payments" {{ block.shopify_attributes }}>
              {% for type in shop.enabled_payment_types %}
                <span class="site-footer__payment" title="{{ type | replace: '_', ' ' | capitalize }}">
                  {{ type | payment_type_svg_tag }}
                </span>
              {% endfor %}
            </div>
          {% endif %}
        {% endfor %}
      {% elsif section.settings.show_payment_icons %}
        <div class="site-footer__payments" aria-label="Accepted payments">
          {% for type in shop.enabled_payment_types %}
            <span class="site-footer__payment" title="{{ type | replace: '_', ' ' | capitalize }}">
              {{ type | payment_type_svg_tag }}
            </span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "image_picker",
      "id": "footer_image",
      "label": "Footer image",
      "info": "Fallback image shown above the footer brand"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "My Store",
      "info": "Used when no logo image is selected"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Store description",
      "default": "Discover quality products and enjoy a simple, reliable shopping experience."
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Maximum content width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Newsletter button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Newsletter button text",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "show_socials",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay in the know"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Sign up for product news and exclusive offers."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Newsletter placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Newsletter button",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "All rights reserved."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment methods",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "footer_image",
      "name": "Footer image",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Image link" },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "Open in new tab", "default": false }
      ]
    },
    {
      "type": "brand",
      "name": "Brand logo",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo image" },
        { "type": "text", "id": "logo_text", "label": "Logo text", "default": "My Store" }
      ]
    },
    {
      "type": "description",
      "name": "Store description",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Discover quality products and enjoy a simple, reliable shopping experience.</p>" },
        { "type": "range", "id": "font_size", "label": "Font size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
        { "type": "color", "id": "color", "label": "Text color" }
      ]
    },
    {
      "type": "social_link",
      "name": "Social link",
      "settings": [
        { "type": "text", "id": "label", "label": "Platform or label", "default": "Instagram" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "Open in new tab", "default": true }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter signup",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the know" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Sign up for product news and exclusive offers." },
        { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Email address" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
      ]
    },
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "copyright",
      "name": "Copyright",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Copyright text",
          "default": "[year] My Store. All rights reserved."
        }
      ]
    },
    {
      "type": "payment_icons",
      "name": "Payment icons",
      "limit": 1,
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "brand",
          "settings": {
            "logo_text": "My Store"
          }
        },
        {
          "type": "description",
          "settings": {}
        },
        {
          "type": "newsletter",
          "settings": {}
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Shop"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Help"
          }
        }
      ]
    }
  ]
}
{% endschema %}
