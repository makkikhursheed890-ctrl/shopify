<style>
  .featured-products {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }

  .featured-products__header {
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.heading_alignment }};
    gap: 20px;
  }

  .featured-products__heading {
    margin: 0;
    font-size: clamp(28px, 4vw, 42px);
  }

  .featured-products__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 16px;
  }

  .featured-product-card__media {
    position: relative;
    aspect-ratio: 1 / 1.05;
    margin-bottom: 12px;
    display: block;
    overflow: hidden;
    background: {{ section.settings.card_background }};
  }
  .featured-product-card__media > a {
    width: 100%;
    height: 100%;
    display: block;
  }

  .featured-product-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .featured-product-card:hover img {
    transform: scale(1.035);
  }

  .featured-product-card__title {
    margin: 0;
    font-size: 15px;
    line-height: 1.35;
  }

  .featured-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .featured-product-card__price {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 700;
  }

  .featured-products__empty {
    grid-column: 1 / -1;
    padding: 40px 20px;
    text-align: center;
  }

  .featured-products__view-all {
    margin-top: 24px;
    min-height: 48px;
    padding: 0 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #111;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 989px) {
    .featured-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .featured-products {
      padding-inline: 16px;
    }

    .featured-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 10px;
    }
  }
</style>

<section class="featured-products" {{ section.shopify_attributes }}>
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'heading' %}
          {% if block.settings.heading != blank %}
            <header class="featured-products__header" {{ block.shopify_attributes }} style="text-align: {{ block.settings.alignment }};">
              <h2 class="featured-products__heading" style="font-size: {{ block.settings.font_size }}px; color: {{ block.settings.color }};">{{ block.settings.heading }}</h2>
            </header>
          {% endif %}
      {% endcase %}
    {% endfor %}
  {% elsif section.settings.heading != blank %}
    <header class="featured-products__header">
      <h2 class="featured-products__heading">{{ section.settings.heading }}</h2>
    </header>
  {% endif %}

  <div class="featured-products__grid">
    {% if section.settings.collection != blank %}
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        <article class="featured-product-card theme-product-card">
          <div class="featured-product-card__media">
            <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 700 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="700"
                height="735"
                loading="lazy"
              >
            {% endif %}
            </a>
            {% render 'theme-product-hover-add', product: product %}
          </div>
          <h3 class="featured-product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
          <div class="featured-product-card__price">{{ product.price | money }}</div>
        </article>
      {% endfor %}
    {% else %}
      {% assign all_products_collection = collections.all %}
      {% for product in all_products_collection.products limit: section.settings.products_to_show %}
        <article class="featured-product-card theme-product-card">
          <div class="featured-product-card__media">
            <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 700 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="700"
                height="735"
                loading="lazy"
              >
            {% endif %}
            </a>
            {% render 'theme-product-hover-add', product: product %}
          </div>
          <h3 class="featured-product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
          <div class="featured-product-card__price">{{ product.price | money }}</div>
        </article>
      {% else %}
        <div class="featured-products__empty">
          <p>No products are available yet.</p>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  {% assign view_all_rendered = false %}
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'button' %}
        {% assign view_all_rendered = true %}
        {% if block.settings.label != blank and block.settings.link != blank %}
          <div style="text-align: {{ block.settings.alignment }};" {{ block.shopify_attributes }}>
            {% render 'theme-block-button',
              block: block,
              label: block.settings.label,
              link: block.settings.link,
              class_name: 'featured-products__view-all',
              background: block.settings.background,
              color: block.settings.color,
              margin_top: block.settings.margin_top,
              open_in_new_tab: block.settings.open_in_new_tab,
              fallback_link: routes.all_products_collection_url
            %}
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if view_all_rendered == false and section.settings.show_view_all %}
    <div style="text-align: center;">
      <a class="featured-products__view-all" href="{{ routes.all_products_collection_url }}">
        {{ section.settings.view_all_label | escape | default: 'View all products' }}
      </a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "class": "section-featured-products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all products button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all button label", "default": "View all products" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "range", "id": "page_width", "min": 960, "max": 1800, "step": 20, "unit": "px", "label": "Page width", "default": 1400 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "space-between", "options": [
      { "value": "flex-start", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "space-between", "label": "Right" }
    ] },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#f5f5f5" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
        { "type": "range", "id": "font_size", "min": 24, "max": 64, "step": 2, "unit": "px", "label": "Font size", "default": 42 },
        { "type": "color", "id": "color", "label": "Text color", "default": "#111111" },
        { "type": "select", "id": "alignment", "label": "Alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    },
    {
      "type": "button",
      "name": "View all button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "View all products" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "Open in new tab", "default": false },
        { "type": "color", "id": "background", "label": "Button background", "default": "#111111" },
        { "type": "color", "id": "color", "label": "Button text", "default": "#ffffff" },
        { "type": "select", "id": "alignment", "label": "Alignment", "default": "center", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
        { "type": "range", "id": "margin_top", "min": 0, "max": 40, "step": 4, "unit": "px", "label": "Spacing above", "default": 8 },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    { "name": "Featured products", "blocks": [{ "type": "heading" }, { "type": "button" }] }
  ]
}
{% endschema %}
