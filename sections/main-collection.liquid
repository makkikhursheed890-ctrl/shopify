<style>
  .main-collection {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }

  .collection-header {
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid #e7e7e7;
  }

  .collection-header__title {
    margin: 0;
    font-size: clamp(32px, 5vw, 58px);
    line-height: 1;
  }

  .collection-header__description {
    max-width: 700px;
    margin: 16px 0 0;
    line-height: 1.7;
    color: #666;
  }

  .collection-toolbar {
    min-height: 48px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .collection-toolbar__count {
    color: #666;
    font-size: 14px;
  }

  .collection-toolbar__sort {
    height: 44px;
    border: 1px solid #ddd;
    background: #fff;
    padding: 0 36px 0 12px;
    color: inherit;
  }

  .collection-layout {
    display: grid;
    grid-template-columns: {{ section.settings.filter_width }}px minmax(0, 1fr);
    gap: 36px;
  }

  .collection-filters {
    align-self: start;
  }

  .collection-filter {
    border-bottom: 1px solid #e7e7e7;
  }

  .collection-filter summary {
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .collection-filter summary::-webkit-details-marker {
    display: none;
  }

  .collection-filter summary::after {
    content: '+';
    font-size: 18px;
    font-weight: 400;
  }

  .collection-filter[open] summary::after {
    content: '-';
  }

  .collection-filter__values {
    max-height: 240px;
    padding: 0 0 16px;
    overflow-y: auto;
  }

  .collection-filter__value {
    min-height: 34px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  .collection-filter__value input {
    width: 16px;
    height: 16px;
    accent-color: #111;
  }

  .collection-filter__value small {
    margin-left: auto;
    color: #888;
  }

  .collection-active-filters {
    margin-bottom: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .collection-active-filter {
    min-height: 36px;
    border: 1px solid #ddd;
    border-radius: 999px;
    padding: 8px 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    font-size: 13px;
    text-decoration: none;
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.card_row_gap }}px {{ section.settings.card_column_gap }}px;
  }

  .collection-card {
    min-width: 0;
  }

  .collection-card__media {
    position: relative;
    aspect-ratio: 1 / 1.05;
    margin-bottom: 12px;
    overflow: hidden;
    background: {{ section.settings.card_background }};
  }
  .collection-card__media > a {
    width: 100%;
    height: 100%;
    display: block;
  }

  .collection-card__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .collection-card:hover .collection-card__media img {
    transform: scale(1.035);
  }

  .collection-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 6px 9px;
    background: #111;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .collection-card__quick-add {
    position: absolute;
    right: 10px;
    bottom: 10px;
    left: 10px;
    height: 44px;
    border: 0;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text }};
    font-weight: 700;
    cursor: pointer;
    opacity: 0;
    transform: translateY(6px);
    transition: 0.25s ease;
  }

  .collection-card:hover .collection-card__quick-add,
  .collection-card__quick-add:focus-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .collection-card__vendor {
    margin-bottom: 5px;
    color: #777;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .collection-card__title {
    margin: 0;
    font-size: 15px;
    line-height: 1.35;
  }

  .collection-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .collection-card__price {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 700;
  }

  .collection-card__compare {
    margin-left: 7px;
    color: #888;
    font-weight: 400;
    text-decoration: line-through;
  }

  .collection-empty {
    grid-column: 1 / -1;
    padding: 80px 20px;
    text-align: center;
  }

  .collection-pagination {
    margin-top: 48px;
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .collection-pagination a,
  .collection-pagination span {
    width: 44px;
    height: 44px;
    border: 1px solid #ddd;
    display: grid;
    place-items: center;
    color: inherit;
    text-decoration: none;
  }

  .collection-pagination .current {
    border-color: #111;
    background: #111;
    color: #fff;
  }

  @media (max-width: 989px) {
    .collection-layout {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 24px;
    }

    .collection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .main-collection {
      padding-inline: 16px;
    }

    .collection-header {
      margin-bottom: 20px;
    }

    .collection-layout {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .collection-filters {
      border-bottom: 1px solid #e7e7e7;
    }

    .collection-filter__values {
      max-height: 190px;
    }

    .collection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 10px;
    }

    .collection-card__quick-add {
      opacity: 1;
      transform: none;
      height: 40px;
    }

    .collection-toolbar {
      align-items: flex-end;
    }
  }
</style>

<section class="main-collection" {{ section.shopify_attributes }}>
  <header class="collection-header">
    {% assign collection_header_rendered = false %}
    {% for block in section.blocks %}
      {% if block.type == 'heading' %}
        {% assign collection_header_rendered = true %}
        {% assign collection_heading_content = block.settings.heading | default: collection.title %}
        {% render 'theme-block-heading',
          block: block,
          heading: collection_heading_content,
          tag: 'h1',
          class_name: 'collection-header__title',
          font_size: block.settings.font_size,
          color: block.settings.color,
          alignment: block.settings.alignment
        %}
      {% elsif block.type == 'description' %}
        {% assign collection_header_rendered = true %}
        {% assign description_content = block.settings.text | default: collection.description %}
        {% render 'theme-block-rich-text',
          block: block,
          text: description_content,
          class_name: 'collection-header__description',
          font_size: block.settings.font_size,
          color: block.settings.color,
          alignment: block.settings.alignment
        %}
      {% endif %}
    {% endfor %}
    {% if collection_header_rendered == false %}
      <h1 class="collection-header__title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="collection-header__description">{{ collection.description }}</div>
      {% endif %}
    {% endif %}
  </header>

  <div class="collection-toolbar">
    <div class="collection-toolbar__count">
      {% if collection.products_count == 1 %}
        1 product
      {% else %}
        {{ collection.products_count }} products
      {% endif %}
    </div>

    {% if section.settings.show_sort %}
      {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
      <select class="collection-toolbar__sort" data-collection-sort aria-label="Sort products">
        {% for option in collection.sort_options %}
          <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
        {% endfor %}
      </select>
    {% endif %}
  </div>

  <div class="collection-layout">
    {% if section.settings.show_filters %}
      <aside class="collection-filters">
        <form id="CollectionFilters" action="{{ collection.url }}" method="get">
          <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">

          {% for filter in collection.filters %}
            <details class="collection-filter" {% if forloop.first %}open{% endif %}>
              <summary>{{ filter.label }}</summary>
              <div class="collection-filter__values">
                {% case filter.type %}
                  {% when 'boolean', 'list' %}
                    {% for value in filter.values %}
                      <label class="collection-filter__value">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >
                        <span>{{ value.label }}</span>
                        <small>{{ value.count }}</small>
                      </label>
                    {% endfor %}
                  {% when 'price_range' %}
                    <label class="collection-filter__value">
                      <span>Price</span>
                    </label>
                    {% assign max_price = filter.range_max | money_without_currency %}
                    <div class="collection-filter__values">
                      <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" placeholder="{{ cart.currency.symbol }} Min">
                      <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" placeholder="{{ max_price }}">
                    </div>
                {% endcase %}
              </div>
            </details>
          {% endfor %}
        </form>
      </aside>
    {% endif %}

    <div>
      <div class="collection-active-filters">
        {% for filter in collection.filters %}
          {% for value in filter.active_values %}
            <a class="collection-active-filter" href="{{ value.url_to_remove }}">Remove {{ filter.label }}: {{ value.label }} &times;</a>
          {% endfor %}
        {% endfor %}
      </div>

      {% paginate collection.products by section.settings.products_per_page %}
        <div class="collection-grid" data-collection-grid>
          {% for product in collection.products %}
            <article class="collection-card theme-product-card">
              <div class="collection-card__media">
                <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {% if product.featured_media %}
                  <img src="{{ product.featured_media | image_url: width: 700 }}" alt="{{ product.featured_media.alt | default: product.title | escape }}" width="700" height="735" loading="lazy">
                {% endif %}
                {% if section.settings.show_sale_badge and product.compare_at_price > product.price %}
                  <span class="collection-card__badge">Sale</span>
                {% endif %}
                </a>
                {% if section.settings.enable_quick_add and product.available %}
                  {% render 'theme-product-hover-add', product: product %}
                {% endif %}
              </div>

              {% if section.settings.show_vendor %}
                <div class="collection-card__vendor">{{ product.vendor }}</div>
              {% endif %}
              <h2 class="collection-card__title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h2>
              <div class="collection-card__price">
                {% if product.price_varies %}<span>From</span>{% endif %}
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <span class="collection-card__compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </article>
          {% else %}
            <div class="collection-empty">
              <h2>No products found</h2>
              <p>Try removing one of the active filters.</p>
            </div>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="collection-pagination" aria-label="Collection pagination">
            {{ paginate | default_pagination: next: 'Next', previous: 'Previous' }}
          </nav>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>
</section>

<script>
  (() => {
    const sort = document.querySelector('[data-collection-sort]');
    const filterForm = document.querySelector('#CollectionFilters');

    sort?.addEventListener('change', () => {
      const url = new URL(window.location.href);
      url.searchParams.set('sort_by', sort.value);
      window.location.href = url.toString();
    });

    filterForm?.querySelectorAll('input[type="checkbox"], input[type="number"]').forEach((input) => {
      input.addEventListener('change', () => filterForm.submit());
    });

    document.querySelectorAll('[data-quick-add]').forEach((button) => {
      button.addEventListener('click', async (event) => {
        event.preventDefault();
        event.stopPropagation();
        const original = button.textContent;
        button.disabled = true;
        button.textContent = 'Adding...';
        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ id: Number(button.dataset.quickAdd), quantity: 1 })
          });
          if (!response.ok) throw new Error('Could not add product');
          const cart = await fetch('/cart.js').then((result) => result.json());
          document.querySelectorAll('.site-header__cart-count').forEach((count) => {
            count.textContent = cart.item_count;
          });
          button.textContent = 'Added';
          window.setTimeout(() => {
            button.textContent = original;
            button.disabled = false;
          }, 1400);
        } catch (error) {
          button.textContent = 'Try again';
          button.disabled = false;
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Main collection",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "page_width", "min": 960, "max": 1800, "step": 20, "unit": "px", "label": "Page width", "default": 1400 },
    { "type": "range", "id": "products_per_page", "min": 4, "max": 48, "step": 4, "label": "Products per page", "default": 16 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "range", "id": "card_column_gap", "min": 4, "max": 40, "step": 2, "unit": "px", "label": "Product horizontal gap", "default": 16 },
    { "type": "range", "id": "card_row_gap", "min": 16, "max": 60, "step": 4, "unit": "px", "label": "Product vertical gap", "default": 28 },
    { "type": "range", "id": "filter_width", "min": 180, "max": 320, "step": 10, "unit": "px", "label": "Filter width", "default": 240 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 },
    { "type": "checkbox", "id": "show_filters", "label": "Show filters", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Show sorting", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Show sale badge", "default": true },
    { "type": "checkbox", "id": "enable_quick_add", "label": "Enable quick add", "default": true },
    { "type": "text", "id": "quick_add_label", "label": "Quick add label", "default": "Quick add" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#f5f5f5" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#111111" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Collection heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading override", "info": "Leave blank to use the collection title" },
        { "type": "range", "id": "font_size", "min": 28, "max": 72, "step": 2, "unit": "px", "label": "Font size", "default": 58 },
        { "type": "color", "id": "color", "label": "Text color", "default": "#111111" },
        { "type": "select", "id": "alignment", "label": "Alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    },
    {
      "type": "description",
      "name": "Collection description",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Description override", "info": "Leave blank to use the collection description" },
        { "type": "range", "id": "font_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 16 },
        { "type": "color", "id": "color", "label": "Text color", "default": "#111111" },
        { "type": "select", "id": "alignment", "label": "Alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
        { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop/tablet", "default": true },
        { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    { "name": "Main collection", "blocks": [{ "type": "heading" }, { "type": "description" }] }
  ]
}
{% endschema %}
